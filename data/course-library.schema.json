{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/data/course-library.schema.json",
  "title": "1200km Courses and Learning Paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "description",
    "published_at",
    "updated_at",
    "editorial_policy",
    "courses",
    "reviews",
    "learning_paths"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 40, "maxLength": 300 },
    "published_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "editorial_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independence", "completion_rule", "evidence_rule", "commercial_rule"],
      "properties": {
        "independence": { "type": "string", "minLength": 20 },
        "completion_rule": { "type": "string", "minLength": 20 },
        "evidence_rule": { "type": "string", "minLength": 20 },
        "commercial_rule": { "type": "string", "minLength": 20 }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/course" }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    },
    "learning_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/learningPath" }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "localUrl": { "type": "string", "pattern": "^/(?!/)[^\\\\\\u0000-\\u001f\\u007f]*$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "creator", "creator_url", "canonical_url", "summary", "status",
        "level", "format", "published_at", "updated_at", "planned_modules", "available_modules",
        "topics", "audiences", "facts_verified_at", "fact_sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 5 },
        "creator": { "type": "string", "minLength": 2 },
        "creator_url": { "$ref": "#/$defs/httpsUrl" },
        "canonical_url": { "$ref": "#/$defs/httpsUrl" },
        "summary": { "type": "string", "minLength": 40, "maxLength": 320 },
        "status": { "enum": ["current-development", "released", "archived"] },
        "level": { "enum": ["foundation", "foundation-to-intermediate", "intermediate", "advanced", "mixed"] },
        "format": { "enum": ["self-paced", "instructor-led", "cohort", "hybrid"] },
        "published_at": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" },
        "planned_modules": { "type": "integer", "minimum": 1 },
        "available_modules": { "type": "integer", "minimum": 1 },
        "topics": { "$ref": "#/$defs/stringList" },
        "audiences": { "$ref": "#/$defs/stringList" },
        "facts_verified_at": { "$ref": "#/$defs/date" },
        "fact_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "provider", "provider_url", "course_url", "syllabus_url",
        "canonical_url", "full_review_url", "summary", "status", "recommendation",
        "recommendation_label", "level", "format", "completed_at", "published_at", "updated_at",
        "review_scope", "syllabus_verified_at",
        "advertised_content_hours", "learning_materials", "companion_count", "topics", "audiences",
        "evidence", "strengths", "limitations", "facts_verified_at", "official_fact_sources", "local_evidence_sources",
        "commercial_disclosure", "cover"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 5 },
        "provider": { "type": "string", "minLength": 2 },
        "provider_url": { "$ref": "#/$defs/httpsUrl" },
        "course_url": { "$ref": "#/$defs/httpsUrl" },
        "syllabus_url": { "$ref": "#/$defs/httpsUrl" },
        "canonical_url": { "$ref": "#/$defs/httpsUrl" },
        "full_review_url": { "$ref": "#/$defs/httpsUrl" },
        "summary": { "type": "string", "minLength": 40, "maxLength": 320 },
        "status": { "const": "completed" },
        "recommendation": { "enum": ["recommended", "conditional", "not-recommended"] },
        "recommendation_label": { "type": "string", "minLength": 5 },
        "level": { "enum": ["foundation", "foundation-to-intermediate", "intermediate", "advanced", "mixed"] },
        "format": { "enum": ["self-paced", "instructor-led", "cohort", "hybrid"] },
        "completed_at": { "$ref": "#/$defs/date" },
        "published_at": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" },
        "review_scope": { "type": "string", "minLength": 20, "maxLength": 180 },
        "syllabus_verified_at": { "$ref": "#/$defs/date" },
        "advertised_content_hours": { "type": "number", "exclusiveMinimum": 0 },
        "learning_materials": { "type": "integer", "minimum": 1 },
        "companion_count": { "type": "integer", "minimum": 0 },
        "topics": { "$ref": "#/$defs/stringList" },
        "audiences": { "$ref": "#/$defs/stringList" },
        "evidence": { "$ref": "#/$defs/stringList" },
        "strengths": { "$ref": "#/$defs/stringList" },
        "limitations": { "$ref": "#/$defs/stringList" },
        "facts_verified_at": { "$ref": "#/$defs/date" },
        "official_fact_sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        },
        "local_evidence_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpsUrl" }
        },
        "commercial_disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_basis", "affiliate_link", "provider_controlled_conclusions"],
          "properties": {
            "access_basis": { "enum": ["self-funded", "complimentary", "not-disclosed"] },
            "affiliate_link": { "type": "boolean" },
            "provider_controlled_conclusions": { "type": "boolean" }
          }
        },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt", "width", "height"],
          "properties": {
            "src": { "$ref": "#/$defs/localUrl" },
            "alt": { "type": "string", "minLength": 10 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "learningPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "status", "level", "topic", "published_at", "updated_at", "facts_verified_at", "related_review_ids", "related_course_ids", "outcomes", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 5 },
        "summary": { "type": "string", "minLength": 40, "maxLength": 320 },
        "status": { "const": "published" },
        "level": { "enum": ["foundation", "foundation-to-intermediate", "intermediate", "advanced", "mixed"] },
        "topic": { "type": "string", "minLength": 2 },
        "published_at": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" },
        "facts_verified_at": { "$ref": "#/$defs/date" },
        "related_review_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "related_course_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "outcomes": { "$ref": "#/$defs/stringList" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "title", "kind", "url"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 5 },
              "kind": { "enum": ["guide", "lab-guide", "learning-record", "lab", "assessment"] },
              "url": { "$ref": "#/$defs/localUrl" }
            }
          }
        }
      }
    }
  }
}

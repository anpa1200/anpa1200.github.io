{"schema_version":1,"reviewed_at":"2026-09-21","article_url":"https://1200km.com/articles/read/2026/2026-04-20-malicious-activity-as-a-statistical-signal-a-detection-engineering-analysis-of-anomaly-bas-90df8b6dea12/","policy":"Navigation topics, not independently validated incidents or detection coverage.","tags":[{"id":"anomaly-volumetric","label":"Anomaly: Volumetric","definition":"Unusual total data or event volume relative to a relevant entity or workload baseline.","exclude":"File size, dataset size or attack volume mentioned without an analytical comparison."},{"id":"anomaly-frequency-rate","label":"Anomaly: Frequency / Rate","definition":"Unexpected event frequency, repetition or rate within a defined window.","exclude":"An attack name such as brute force without rate, burst, threshold or detection analysis."},{"id":"anomaly-temporal","label":"Anomaly: Temporal","definition":"Unexpected timing, periodicity, intervals or activity relative to a temporal context.","exclude":"Publication dates, chronological incident narratives or ordinary scheduled operation alone."},{"id":"anomaly-peer-group","label":"Anomaly: Peer Group","definition":"Behavior inconsistent with comparable roles, hosts, applications or cohorts.","exclude":"Any reference to a threat group, user role or industry without behavioral comparison."},{"id":"anomaly-sequence","label":"Anomaly: Sequence","definition":"Suspicious ordering or combination of related events, evaluated as a behavioral chain.","exclude":"Installation steps, course order, or a kill-chain list without detection or correlation analysis."},{"id":"anomaly-graph-relationship","label":"Anomaly: Graph / Relationship","definition":"New or unusual entity-to-entity relationships, access paths or communication edges.","exclude":"A knowledge graph feature or threat-actor relationship without anomalous interaction analysis."},{"id":"anomaly-geographic-asn","label":"Anomaly: Geographic / ASN","definition":"Unfamiliar source location or network context, including travel inconsistencies.","exclude":"Actor nationality, victim geography or an ASN IOC without source-history comparison."},{"id":"anomaly-identity-access","label":"Anomaly: Identity / Access","definition":"Unexpected identity, token, factor, session, privilege or resource-access behavior.","exclude":"Routine IAM configuration, credential theft capability or authentication mechanics alone."},{"id":"anomaly-rare-process-service","label":"Anomaly: Rare Process / Service","definition":"Uncommon or first-seen process/service behavior relative to host role or approved inventory.","exclude":"Any malware process or Windows service without rarity, inventory or contextual reasoning."},{"id":"anomaly-parent-child","label":"Anomaly: Parent–Child Execution","definition":"Suspicious process ancestry or child execution evaluated in its host/application context.","exclude":"Generic process-creation API descriptions without lineage or defensive interpretation."},{"id":"anomaly-data-movement","label":"Anomaly: Data Movement","definition":"Unexpected transfer, export, destination or data-access flow with defensive interpretation.","exclude":"Exfiltration as a tactic name or authorized data migration without transfer analysis."},{"id":"anomaly-protocol-application","label":"Anomaly: Protocol / Application","definition":"Protocol or application use inconsistent with expected structure, destination or purpose.","exclude":"Normal HTTP, DNS or application setup without behavioral or protocol-abuse analysis."},{"id":"anomaly-negative-absence","label":"Anomaly: Negative / Absence","definition":"Unexpected disappearance of expected telemetry, heartbeats or activity.","exclude":"A generic logging gap, missing data, or a tool-disable event without expected-stream reasoning."},{"id":"anomaly-state-change","label":"Anomaly: State Change","definition":"Unexpected changes to accounts, permissions, configuration, services or resources.","exclude":"Normal setup instructions or a change event with no security/detection context."},{"id":"anomaly-multi-event-correlation","label":"Anomaly: Multi-Event Correlation","definition":"Multiple weak signals linked by entity and time to evaluate a suspicious behavioral chain. This is a composition pattern, not an independent statistical family.","exclude":"Generic enrichment, several unlinked alerts, a product correlation feature or a chronological narrative alone."}],"pages":{"/adversarygraph-docs/attack-simulation":["anomaly-temporal"],"/anomaly-detection-atlas/attack-basic-detection-rule-catalog":["anomaly-frequency-rate","anomaly-sequence","anomaly-negative-absence"],"/anomaly-detection-atlas/attack-statistical-anomaly-mapping":["anomaly-volumetric","anomaly-frequency-rate","anomaly-temporal","anomaly-peer-group","anomaly-sequence","anomaly-graph-relationship","anomaly-identity-access","anomaly-rare-process-service","anomaly-parent-child","anomaly-state-change"],"/anomaly-detection-atlas/security-log-source-taxonomy":["anomaly-parent-child"],"/anomaly-detection-atlas/statistical-anomaly-taxonomy":["anomaly-volumetric","anomaly-frequency-rate","anomaly-temporal","anomaly-peer-group","anomaly-sequence","anomaly-graph-relationship","anomaly-geographic-asn","anomaly-identity-access","anomaly-data-movement","anomaly-negative-absence"],"/articles/read/2025/2025-02-24-soc-tier-1-the-complete-onboarding-guide-to-security-monitoring-and-incident-response-824a1dfe4476":["anomaly-identity-access"],"/articles/read/2025/2025-07-11-sending-eks-control-plane-logs-via-aws-lambda-c4ce0cf84c5b":["anomaly-volumetric"],"/articles/read/2025/2025-07-20-cyberattacks-on-4g-lte-telecom-networks-threat-mapping-and-defense-bd0e7fe76f54":["anomaly-volumetric"],"/articles/read/2025/2025-07-20-cyberattacks-on-5g-telecom-networks-threat-mapping-and-defense-aa74f680a7df":["anomaly-data-movement"],"/articles/read/2025/2025-07-25-phishing-email-awareness-protecting-employees-and-organizations-cf5bc57a0511":["anomaly-temporal"],"/ar
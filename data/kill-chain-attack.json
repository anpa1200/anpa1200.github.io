  "stages": {
    "reconnaissance": [
      {
        "id": "T1595.001",
        "relevance": "Enumerating target IP ranges can reveal reachable systems before an intrusion."
      },
      {
        "id": "T1595.002",
        "relevance": "Testing exposed systems for known weaknesses informs target and exploit selection; a scan does not establish successful exploitation."
      },
      {
        "id": "T1593.001",
        "relevance": "Public social profiles can inform targeting, roles, relationships, and pretexts."
      },
      {
        "id": "T1593.002",
        "relevance": "Search-engine results can reveal public documents, services, and organizational information."
      },
      {
        "id": "T1596.001",
        "relevance": "Public and historical DNS data can expose target infrastructure and relationships."
      },
      {
        "id": "T1596.002",
        "relevance": "Registration records can provide infrastructure and ownership leads, with privacy and shared-service limits."
      },
      {
        "id": "T1596.003",
        "relevance": "Certificate records can identify candidate domains and public services."
      },
      {
        "id": "T1592.002",
        "relevance": "Knowledge of deployed software can help an adversary choose a compatible capability."
      },
      {
        "id": "T1589.002",
        "relevance": "Collected email addresses can support later targeting and delivery; collection is distinct from sending a message."
      }
    ],
    "weaponization": [
      {
        "id": "T1587.001",
        "relevance": "Developing or adapting malware prepares a capability before it reaches a target."
      },
      {
        "id": "T1587.002",
        "relevance": "Preparing code-signing certificates can support the packaging and apparent provenance of a malicious artifact."
      },
      {
        "id": "T1587.004",
        "relevance": "Developing an exploit prepares a mechanism for a later exploitation attempt."
      },
      {
        "id": "T1588.001",
        "relevance": "Obtaining existing malware is an alternative to developing a new payload."
      },
      {
        "id": "T1588.002",
        "relevance": "Acquiring tools can support capability preparation; possession alone does not prove use against a target."
      },
      {
        "id": "T1588.005",
        "relevance": "Obtaining an exploit prepares a capability that may later be delivered or triggered."
      },
      {
        "id": "T1608.001",
        "relevance": "Uploading malware to staged infrastructure prepares a distribution route; this overlaps preparation and delivery."
      }
    ],
    "delivery": [
      {
        "id": "T1566.001",
        "relevance": "An attachment brings an adversary-controlled artifact to a recipient; receipt does not prove execution."
      },
      {
        "id": "T1566.002",
        "relevance": "A phishing link directs the target toward adversary-controlled content or an access-abuse interaction."
      },
      {
        "id": "T1566.003",
        "relevance": "An external messaging or collaboration service can carry the adversary’s message to the target."
      },
      {
        "id": "T1189",
        "relevance": "A visited website can deliver malicious content and trigger client exploitation, so this example spans stages."
      },
      {
        "id": "T1195.002",
        "relevance": "A compromised software distribution path can deliver a malicious component through an otherwise trusted channel."
      },
      {
        "id": "T1091",
        "relevance": "Removable media can carry malicious content between systems; later execution must be established separately."
      },
      {
        "id": "T1608.001",
        "relevance": "Staged malware hosting supports delivery infrastructure, but an upload does not establish that a target downloaded it."
      }
    ],
    "exploitation": [
      {
        "id": "T1203",
        "relevance": "A client-side vulnerability can turn delivered content into code execution."
      },
      {
        "id": "T1190",
        "relevance": "A vulnerable internet-facing application can provide the entry point for an intrusion."
      },
      {
        "id": "T1068",
        "relevance": "Exploitation can recur after access to obtain greater privileges; it need not be confined to initial entry."
      },
      {
        "id": "T1210",
        "relevance": "A vulnerable remote service can be exploited during internal expansion, illustrating repeated rather than strictly linear stages."
      },
      {
        "id": "T1204.001",
        "relevance": "A user following a malicious link may enable unauthorized behavior. This is a user-action example, not proof of a software flaw."
      },
      {
        "id": "T1204.002",
        "relevance": "Opening a malicious file can trigger execution; distinguish that action from vulnerability exploitation and from file delivery."
      }
    ],
    "installation": [
      {
        "id": "T1547.001",
        "relevance": "A startup entry can arrange repeated execution of an implanted component; correlate it with the referenced file and process."
      },
      {
        "id": "T1543.003",
        "relevance": "A Windows service can establish execution and continued access for a newly deployed component."
      },
      {
        "id": "T1543.002",
        "relevance": "A systemd service can establish execution of a component on a Linux host."
      },
      {
        "id": "T1053.005",
        "relevance": "A scheduled task can repeatedly launch a deployed payload; authorized administration is an important comparison."
      },
      {
        "id": "T1505.003",
        "relevance": "A web shell places an operator-accessible component in a compromised server environment."
      },
      {
        "id": "T1546.003",
        "relevance": "An event subscription can establish a trigger for later execution without a conventional standalone installer."
      },
      {
        "id": "T1055",
        "relevance": "Injection can place code into another process as part of establishing a memory-resident foothold; it does not inherently imply persistence."
      }
    ],
    "command-and-control": [
      {
        "id": "T1071.001",
        "relevance": "Web protocols can carry command traffic; correlate requests with process identity and subsequent behavior."
      },
      {
        "id": "T1071.004",
        "relevance": "DNS can carry command-channel traffic; unusual queries require corroboration rather than a protocol-only verdict."
      },
      {
        "id": "T1573.001",
        "relevance": "Symmetric encryption can conceal command-channel content while metadata and endpoint evidence remain observable."
      },
      {
        "id": "T1573.002",
        "relevance": "Asymmetric encryption can protect a command channel; encryption alone is not evidence of malicious control."
      },
      {
        "id": "T1090.003",
        "relevance": "Multiple proxies can separate the compromised host from the operator and complicate infrastructure attribution."
      },
      {
        "id": "T1105",
        "relevance": "A command channel may transfer additional tools or payloads after the first foothold, overlapping delivery and installation."
      },
      {
        "id": "T1102.002",
        "relevance": "A legitimate web service can be abused for two-way operator communication."
      },
      {
        "id": "T1041",
        "relevance": "A command channel may also carry stolen data, overlapping communication with actions on objectives."
      }
    ],
    "actions-on-objectives": [
      {
        "id": "T1005",
        "relevance": "Collecting local data can serve an information-theft or espionage objective; collection is not proof of external transfer."
      },
      {
        "id": "T1113",
        "relevance": "Captured screenshots can support surveillance and intelligence collection."
      },
      {
        "id": "T1056.001",
        "relevance": "Keystroke capture can collect credentials or information relevant to an operator’s objective."
      },
      {
        "id": "T1560.001",
        "relevance": "Archiving collected material can prepare it for transfer; archiving alone is not proof of theft."
      },
      {
        "id": "T1041",
        "relevance": "Transferring collected information over a command channel connects C2 activity to an exfiltration objective."
      },
      {
        "id": "T1048",
        "relevance": "An alternative protocol can transfer collected information outside the command channel."
      },
      {
        "id": "T1486",
        "relevance": "Encryption of victim data can support extortion or disruption; confirm actual affected assets and recoverability."
      },
      {
        "id": "T1485",
        "relevance": "Destruction of data can directly pursue sabotage or operational disruption."
      },
      {
        "id": "T1490",
        "relevance": "Disabling recovery mechanisms can support destructive or extortion activity, but is not itself proof of completed encryption."
      },
      {
        "id": "T1496",
        "relevance": "Abusing victim computing resources can pursue financial or operational benefit without conventional data theft."
      }
    ]
  }
}

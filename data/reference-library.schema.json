{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/data/reference-library.schema.json",
  "title": "1200km site-wide reference library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "title",
    "description",
    "evidence_boundary",
    "source_dataset",
    "record_count",
    "core_count",
    "context_count",
    "site_count",
    "usage_link_count",
    "unique_tag_count",
    "tag_assignment_count",
    "records"
  ],
  "properties": {
    "$schema": { "const": "./reference-library.schema.json" },
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "evidence_boundary": { "type": "string", "minLength": 1 },
    "source_dataset": { "type": "string", "minLength": 1 },
    "record_count": { "type": "integer", "minimum": 108 },
    "core_count": { "const": 103 },
    "context_count": { "const": 5 },
    "site_count": { "type": "integer", "minimum": 1 },
    "usage_link_count": { "type": "integer", "minimum": 1 },
    "unique_tag_count": { "type": "integer", "minimum": 1 },
    "tag_assignment_count": { "type": "integer", "minimum": 108 },
    "records": {
      "type": "array",
      "minItems": 108,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "url", "publisher", "published_at", "inclusion", "tags", "used_in"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:ai-attack-reference:pub-[0-9]{3}|site-reference:[a-z0-9.+/-]+:[a-z0-9.+/-]+)$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "minLength": 20, "maxLength": 300 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "type": "string", "minLength": 1 },
        "published_at": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?(?:-[0-9]{2})?$" },
            { "type": "null" }
          ]
        },
        "inclusion": { "enum": ["core", "context", "site"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tag" }
        },
        "used_in": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "type", "domain"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://1200km.com/" },
              "type": { "type": "string", "minLength": 1 },
              "domain": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet", "type", "value", "key"],
      "properties": {
        "facet": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9.+/-]+$" }
      }
    }
  }
}

{"key":"ics/T0843.001","id":"T0843.001","name":"Download All","domain":"ics","level":"subtechnique","parent_id":"T0843","tactics":["lateral-movement"],"platforms":[],"environments":["ics-ot"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may execute a full program download to a PLC to overwrite the entire PLC program and configuration to deploy a new project or make major changes. This typically requires stopping the PLC and adversely impacting control processes. The ability to perform a full program download to the PLC typically relies on access to a workstation with the vendor-specific PLC programming software installed.","source_url":"https://attack.mitre.org/techniques/T0843/001","source_stix_id":"attack-pattern--77015a55-eef8-4f71-a071-b152f82ec1ef","source_modified":"2026-05-12T15:12:00.642Z","source_object_version":"1.0","telemetry":{"status":"mapped","components":[{"id":"DC0038","name":"Application Log Content","url":"https://attack.mitre.org/datacomponents/DC0038","stix_id":"x-mitre-data-component--9c2fa0ae-7abc-485a-97f6-699e3b6cf9fa","page":"telemetry/DC0038/"},{"id":"DC0110","name":"Asset Inventory","url":"https://attack.mitre.org/datacomponents/DC0110","stix_id":"x-mitre-data-component--b05a614b-033c-4578-b4f2-c63a9feee706","page":"telemetry/DC0110/"},{"id":"DC0108","name":"Device Alarm","url":"https://attack.mitre.org/datacomponents/DC0108","stix_id":"x-mitre-data-component--9d56be63-3501-4dd3-bb5f-63c580833298","page":"telemetry/DC0108/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"}],"strategies":[{"id":"DET0913","name":"Detection of Program Download All","url":"https://attack.mitre.org/detectionstrategies/DET0913","stix_id":"x-mitre-detection-strategy--2e99cd65-aad4-4796-9013-79837d498eb6","relationship_id":"relationship--09676502-c50a-47ca-bbef-fffced52346e"}],"analytics":[{"id":"AN2056","name":"Analytic 2056","url":"https://attack.mitre.org/detectionstrategies/DET0913#AN2056","guidance":"Monitor device alarms for program downloads, although not all devices produce such alarms. Monitor for protocol functions related to program download or modification. Program downloads may be observable in ICS automation protocols and remote management protocols. Consult asset management systems to understand expected program versions. Monitor devices configuration logs which may contain alerts that indicate whether a program download has occurred. Devices may maintain application logs that indicate whether a full program download, online edit, or program append function has occurred.","platforms":["None"],"strategy_id":"DET0913"}],"log_sources":[{"component_id":"DC0108","component":"Device Alarm","name":"Operational Databases","channel":"None","platforms":["None"],"analytic_id":"AN2056","source_url":"https://attack.mitre.org/detectionstrategies/DET0913#AN2056","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0108/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"Traffic","channel":"None","platforms":["None"],"analytic_id":"AN2056","source_url":"https://attack.mitre.org/detectionstrategies/DET0913#AN2056","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"},{"component_id":"DC0110","component":"Asset Inventory","name":"Asset","channel":"None","platforms":["None"],"analytic_id":"AN2056","source_url":"https://attack.mitre.org/detectionstrategies/DET0913#AN2056","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0110/"},{"component_id":"DC0038","component":"Application Log Content","name":"Application Log","channel":"None","platforms":["None"],"analytic_id":"AN2056","source_url":"https://attack.mitre.org/detectionstrategies/DET0913#AN2056","validation":"upstream_definition_not_locally_validated",
{"key":"ics/T0840","id":"T0840","name":"Network Connection Enumeration","domain":"ics","level":"technique","parent_id":null,"tactics":["discovery"],"platforms":["None"],"environments":["ics-ot"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may perform network connection enumeration to discover information about device communication patterns. If an adversary can inspect the state of a network connection with tools, such as Netstat, in conjunction with System Firmware, then they can determine the role of certain devices on the network . The adversary can also use Network Sniffing to watch network traffic for details about the source, destination, protocol, and content.","source_url":"https://attack.mitre.org/techniques/T0840","source_stix_id":"attack-pattern--ea0c980c-5cf0-43a7-a049-59c4c207566e","source_modified":"2026-05-12T15:12:00.723Z","source_object_version":"1.2","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0021","name":"OS API Execution","url":"https://attack.mitre.org/datacomponents/DC0021","stix_id":"x-mitre-data-component--9bde2f9d-a695-4344-bfac-f2dce13d121e","page":"telemetry/DC0021/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0029","name":"Script Execution","url":"https://attack.mitre.org/datacomponents/DC0029","stix_id":"x-mitre-data-component--9f387817-df83-432a-b56b-a8fb7f71eedd","page":"telemetry/DC0029/"}],"strategies":[{"id":"DET0770","name":"Detection of Network Connection Enumeration","url":"https://attack.mitre.org/detectionstrategies/DET0770","stix_id":"x-mitre-detection-strategy--441ded70-7e25-47f1-b55c-0fafb7d4f44c","relationship_id":"rel
{"key":"enterprise/T1550.002","id":"T1550.002","name":"Pass the Hash","domain":"enterprise","level":"subtechnique","parent_id":"T1550","tactics":["lateral-movement"],"platforms":["Windows"],"environments":["cloud-hosted-endpoint","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may “pass the hash” using stolen password hashes to move laterally within an environment, bypassing normal system access controls. Pass the hash (PtH) is a method of authenticating as a user without having access to the user's cleartext password. This method bypasses standard authentication steps that require a cleartext password, moving directly into the portion of the authentication that uses the password hash. When performing PtH,…","source_url":"https://attack.mitre.org/techniques/T1550/002","source_stix_id":"attack-pattern--e624264c-033a-424d-9fd7-fc9c3bbdb03e","source_modified":"2026-05-12T15:12:00.723Z","source_object_version":"2.0","telemetry":{"status":"mapped","components":[{"id":"DC0084","name":"Active Directory Credential Request","url":"https://attack.mitre.org/datacomponents/DC0084","stix_id":"x-mitre-data-component--02d090b6-8157-48da-98a2-517f7edd49fc","page":"telemetry/DC0084/"},{"id":"DC0067","name":"Logon Session Creation","url":"https://attack.mitre.org/datacomponents/DC0067","stix_id":"x-mitre-data-component--9ce98c86-8d30-4043-ba54-0784d478d0b5","page":"telemetry/DC0067/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0409","name":"Detection Strategy for T1550.002 - Pass the Hash (Windows)","url":"https://attack.mitre.org/detectionstrategies/DET0409","stix_id":"x-mitre-detection-strategy--5692084b-878d-44f7-8b38-a3d125894845","relationship_id":"relationship--fa64735f-0ea6-482b-859a-5cb4b9f6f95b"}],"analytics":[{"id":"AN1144","name":"Analytic 1144","url":"https://attack.mitre.org/detectionstrategies/DET0409#AN1144","guidance":"Detects anomalous NTLM LogonType 3 authentications that occur without accompanying domain logon events, especially from lateral systems or involving built-in administrative tools. Monitors for mismatches between source user context and system being accessed. Correlates LogonSession creation, NTLM authentications, and process/service initiation to identify suspicious use of stolen password hashes for remote access or service logon without password entry. Detects overpass-the-hash by combining Kerberos ticket issuance with NTLM-based lateral movement.","platforms":["Windows"],"strategy_id":"DET0409"}],"log_sources":[{"component_id":"DC0067","component":"Logon Session Creation","name":"WinEventLog:Security","channel":"EventCode=4624, 4648","platforms":["Windows"],"analytic_id":"AN1144","source_url":"https://attack.mitre.org/detectionstrategies/DET0409#AN1144","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0067/"},{"component_id":"DC0084","component":"Active Directory Credential Request","name":"WinEventLog:Security","channel":"EventCode=4768","platforms":["Windows"],"analytic_id":"AN1144","source_url":"https://attack.mitre.org/detectionstrategies/DET0409#AN1144","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0084/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1144","source_url":"https://attack.mitre.org/detectionstrategies/DET0409#AN1144","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0032","component":"Process Creation","name":
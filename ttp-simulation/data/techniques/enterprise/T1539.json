://attack.mitre.org/detectionstrategies/DET0509#AN1405","guidance":"Detects automation macros or VBA scripts in documents that access browser file paths, read cookie data, or attempt to exfiltrate browser session tokens over HTTP.","platforms":["Office Suite"],"strategy_id":"DET0509"},{"id":"AN1406","name":"Analytic 1406","url":"https://attack.mitre.org/detectionstrategies/DET0509#AN1406","guidance":"Detects use of session cookies or authentication tokens from unusual user agents or locations. Identifies token reuse without reauthentication or attempts to bypass MFA using previously stolen cookies.","platforms":["SaaS"],"strategy_id":"DET0509"}],"log_sources":[{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN1402","source_url":"https://attack.mitre.org/detectionstrategies/DET0509#AN1402","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"},{"component_id":"DC0061","component":"File Modification","name":"WinEventLog:Sysmon","channel":"EventCode=2","platforms":["Windows"],"analytic_id":"AN1402","source_url":"https://attack.mitre.org/detectionstrategies/DET0509#AN1402","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN1402","source_url":"https://attack.mitre.org/detectionstrategies/DET0509#AN1402","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"open or read to browser cookie storage","platforms":["Linux"],"analytic_id":"AN1403","source_url":"https://attack.mitre.org/detectionstrategies/DET0509#AN1403","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"componen
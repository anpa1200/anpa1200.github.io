{"key":"enterprise/T1106","id":"T1106","name":"Native API","domain":"enterprise","level":"technique","parent_id":null,"tactics":["execution"],"platforms":["Linux","macOS","Windows"],"environments":["cloud-hosted-endpoint","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may interact with the native OS application programming interface (API) to execute behaviors. Native APIs provide a controlled means of calling low-level OS services within the kernel, such as those involving hardware/devices, memory, and processes. These native APIs are leveraged by the OS during system boot (when other system components are not yet initialized) as well as carrying out tasks and requests during routine operations.…","source_url":"https://attack.mitre.org/techniques/T1106","source_stix_id":"attack-pattern--391d824f-0ef1-47a0-b0ee-c59a75e27670","source_modified":"2026-05-12T15:12:00.627Z","source_object_version":"2.3","telemetry":{"status":"mapped","components":[{"id":"DC0016","name":"Module Load","url":"https://attack.mitre.org/datacomponents/DC0016","stix_id":"x-mitre-data-component--c0a4a086-cc20-4e1e-b7cb-29d99dfa3fb1","page":"telemetry/DC0016/"},{"id":"DC0035","name":"Process Access","url":"https://attack.mitre.org/datacomponents/DC0035","stix_id":"x-mitre-data-component--1887a270-576a-4049-84de-ef746b2572d6","page":"telemetry/DC0035/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0529","name":"Behavioral Detection of Native API Invocation via Unusual DLL Loads and Direct Syscalls","url":"https://attack.mitre.org/detectionstrategies/DET0529","stix_id":"x-mitre-detection-strategy--36654ec6-5019-4e79-b299-1fbf3a03e064","relationship_id":"relationship--dc9d1fc2-471b-49c3-b372-9703fd5125f4"}],"analytics":[{"id":"AN1465","name":"Analytic 1465","url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1465","guidance":"Unusual or suspicious processes loading critical native API DLLs (e.g., ntdll.dll, kernel32.dll) followed by direct syscall behavior, memory manipulation, or hollowing.","platforms":["Windows"],"strategy_id":"DET0529"},{"id":"AN1466","name":"Analytic 1466","url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1466","guidance":"Userland processes invoking syscall-heavy libraries (libc, glibc) followed by fork, mmap, or ptrace behavior commonly associated with code injection or memory manipulation.","platforms":["Linux"],"strategy_id":"DET0529"},{"id":"AN1467","name":"Analytic 1467","url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1467","guidance":"Execution of processes that link to CoreServices or Foundation APIs followed by creation of memory regions, code execution, or abnormal library injection.","platforms":["macOS"],"strategy_id":"DET0529"}],"log_sources":[{"component_id":"DC0016","component":"Module Load","name":"WinEventLog:Sysmon","channel":"EventCode=7","platforms":["Windows"],"analytic_id":"AN1465","source_url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1465","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0016/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN1465","source_url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1465","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1465","source_url":"https://attack.mitre.org/detectionstrategies/DET0529#AN1465","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0035","component":"Process Access","name":"auditd:SYSCALL"
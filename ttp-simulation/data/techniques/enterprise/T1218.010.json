{"key":"enterprise/T1218.010","id":"T1218.010","name":"Regsvr32","domain":"enterprise","level":"subtechnique","parent_id":"T1218","tactics":["stealth"],"platforms":["Windows"],"environments":["cloud-hosted-endpoint","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may abuse Regsvr32.exe to proxy execution of malicious code. Regsvr32.exe is a command-line program used to register and unregister object linking and embedding controls, including dynamic link libraries (DLLs), on Windows systems. The Regsvr32.exe binary may also be signed by Microsoft. Malicious usage of Regsvr32.exe may avoid triggering security tools that may not monitor execution of, and modules loaded by, the regsvr32.exe…","source_url":"https://attack.mitre.org/techniques/T1218/010","source_stix_id":"attack-pattern--b97f1d35-4249-4486-a6b5-ee60ccf24fab","source_modified":"2026-05-12T15:12:00.709Z","source_object_version":"3.0","telemetry":{"status":"mapped","components":[{"id":"DC0016","name":"Module Load","url":"https://attack.mitre.org/datacomponents/DC0016","stix_id":"x-mitre-data-component--c0a4a086-cc20-4e1e-b7cb-29d99dfa3fb1","page":"telemetry/DC0016/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0282","name":"Detection Strategy for System Binary Proxy Execution: Regsvr32","url":"https://attack.mitre.org/detectionstrategies/DET0282","stix_id":"x-mitre-detection-strategy--0a931f22-4820-48aa-8051-056da15a6183","relationship_id":"relationship--6a5e3a15-ba2a-4836-ab40-8f5d8a3175bf"}],"analytics":[{"id":"AN0785","name":"Analytic 0785","url":"https://attack.mitre.org/detecti
{"key":"enterprise/T1614","id":"T1614","name":"System Location Discovery","domain":"enterprise","level":"technique","parent_id":null,"tactics":["discovery"],"platforms":["IaaS","Linux","macOS","Windows"],"environments":["cloud","cloud-hosted-endpoint","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may gather information in an attempt to calculate the geographical location of a victim host. Adversaries may use the information from System Location Discovery during automated discovery to shape follow-on behaviors, including whether or not the adversary fully infects the target and/or attempts specific actions. Adversaries may attempt to infer the location of a system using various system checks, such as time zone, keyboard…","source_url":"https://attack.mitre.org/techniques/T1614","source_stix_id":"attack-pattern--c877e33f-1df6-40d6-b1e7-ce70f16f4979","source_modified":"2026-05-12T15:12:00.716Z","source_object_version":"1.1","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0021","name":"OS API Execution","url":"https://attack.mitre.org/datacomponents/DC0021","stix_id":"x-mitre-data-component--9bde2f9d-a695-4344-bfac-f2dce13d121e","page":"telemetry/DC0021/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0043","name":"Detection Strategy for System Location Discovery","url":"https://attack.mitre.org/detectionstrategies/DET0043","stix_id":"x-mitre-detec
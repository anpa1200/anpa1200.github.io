ck.mitre.org/detectionstrategies/DET0241#AN0675","guidance":"Detects forged Kerberos Silver Tickets by identifying anomalous Kerberos service ticket activity such as malformed fields in logon events, TGS requests without interaction with the KDC, and access attempts using service accounts outside expected hosts/resources. Also monitors suspicious processes accessing LSASS memory for credential dumping.","platforms":["Windows"],"strategy_id":"DET0241"}],"log_sources":[{"component_id":"DC0088","component":"Logon Session Metadata","name":"WinEventLog:Security","channel":"EventCode=4672, 4634","platforms":["Windows"],"analytic_id":"AN0675","source_url":"https://attack.mitre.org/detectionstrategies/DET0241#AN0675","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0088/"},{"component_id":"DC0084","component":"Active Directory Credential Request","name":"WinEventLog:Kerberos","channel":"Kerberos TGS-REQ anomalies without KDC validation (Silver Ticket behavior)","platforms":["Windows"],"analytic_id":"AN0675","source_url":"https://attack.mitre.org/detectionstrategies/DET0241#AN0675","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0084/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN0675","source_url":"https://attack.mitre.org/detectionstrategies/DET0241#AN0675","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"}],"unresolved_references":[],"basis":"ATT&CK detects relationship → detection strategy → analytic → log-source component reference","planning_inputs":[],"visibility":"source_mapped","planning_references":[],"references":[{"id":"DC0084","name":"Active Directory Credential Request","tag":"Active Directory Credential Request","page":"telemetry/DC0084/","kind":"attack_component"},{"id":"DC0088","name":"Logon Session Metadata","tag":"Logon Session Metadat
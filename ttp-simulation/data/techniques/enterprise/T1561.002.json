{"key":"enterprise/T1561.002","id":"T1561.002","name":"Disk Structure Wipe","domain":"enterprise","level":"subtechnique","parent_id":"T1561","tactics":["impact"],"platforms":["Linux","macOS","Network Devices","Windows"],"environments":["cloud-hosted-endpoint","network-infrastructure","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may corrupt or wipe the disk data structures on a hard drive necessary to boot a system; targeting specific critical systems or in large numbers in a network to interrupt availability to system and network resources. Adversaries may attempt to render the system unable to boot by overwriting critical data located in structures such as the master boot record (MBR) or partition table. The data contained in disk structures may include…","source_url":"https://attack.mitre.org/techniques/T1561/002","source_stix_id":"attack-pattern--0af0ca99-357d-4ba1-805f-674fdfb7bef9","source_modified":"2026-05-12T15:12:00.620Z","source_object_version":"1.2","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0054","name":"Drive Access","url":"https://attack.mitre.org/datacomponents/DC0054","stix_id":"x-mitre-data-component--73ff2dcc-24b1-4368-b9dc-706dd9e68354","page":"telemetry/DC0054/"},{"id":"DC0046","name":"Drive Modification","url":"https://attack.mitre.org/datacomponents/DC0046","stix_id":"x-mitre-data-component--4dcd8ba3-2075-4f8b-941e-39884ffaac08","page":"telemetry/DC0046/"},{"id":"DC0079","name":"Driver Load","url":"https://attack.mitre.org/datacomponents/DC0079","stix_id":"x-mitre-data-component--3551476e-14f5-4e48-a518-e82135329e03","page":"telemetry/DC0079/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0002","name":"User Account Authentication","url":"https://attack.mitre.org/datacomponents/DC0002","stix_id":"x-mitre-data-component--a953ca55-921a-44f7-9b8d-3d40141aa17e","page":"telemetry/DC0002/"},{"id":"DC0013","name":"User Account Metadata","url":"https://attack.mitre.org/datacomponents/DC0013","stix_id":"x-mitre-data-component--b5d0492b-cda4-421c-8e51-ed2b8d85c5d0","page":"telemetry/DC0013/"}],"strategies":[{"id":"DET0297","name":"Detection Strategy for Disk Structure Wipe via Boot/Partition Overwrite","url":"https://attack.mitre.org/detectionstrategies/DET0297","stix_id":"x-mitre-detection-strategy--1dd8a02b-b447-48ed-a146-ad955c9b2dc1","relationship_id":"relationship--c70c05f4-d7bc-47a1-b077-f6f11fca564b"}],"analytics":[{"id":"AN0827","name":"Analytic 0827","url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0827","guidance":"Processes attempting raw disk access to overwrite sensitive structures such as the MBR or partition table using \\\\.\\PhysicalDrive notation. Detection relies on correlating process creation, privilege escalation, and raw sector writes in Sysmon and Security logs.","platforms":["Windows"],"strategy_id":"DET0297"},{"id":"AN0828","name":"Analytic 0828","url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0828","guidance":"Execution of utilities (dd, hdparm, sgdisk) or custom binaries attempting to overwrite disk boot structures (/dev/sda MBR sector or partition tables). Detection correlates shell execution with syscalls writing to sector 0 or disk metadata blocks.","platforms":["Linux"],"strategy_id":"DET0297"},{"id":"AN0829","name":"Analytic 0829","url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0829","guidance":"Abnormal invocation of diskutil or asr that modifies partition tables or initializes raw devices. Monitor for IOKit system calls targeting disk headers or EFI boot sectors, correlated with elevated privileges.","platforms":["macOS"],"strategy_id":"DET0297"},{"id":"AN0830","name":"Analytic 0830","url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0830","guidance":"Execution of destructive CLI commands such as format flash:, format disk, or equivalent vendor-specific commands that erase filesystem structures. Detection correlates AAA logs showing privileged access with immediate format/erase commands.","platforms":["Network Devices"],"strategy_id":"DET0297"}],"log_sources":[{"component_id":"DC0013","component":"User Account Metadata","name":"WinEventLog:Security","channel":"EventCode=4673","platforms":["Windows"],"analytic_id":"AN0827","source_url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0827","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0013/"},{"component_id":"DC0046","component":"Drive Modification","name":"WinEventLog:Sysmon","channel":"Raw write attempts targeting \\\\.\\PhysicalDrive0 or sector 0 (MBR/partition table)","platforms":["Windows"],"analytic_id":"AN0827","source_url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0827","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0046/"},{"component_id":"DC0079","component":"Driver Load","name":"WinEventLog:Sysmon","channel":"EventCode=6","platforms":["Windows"],"analytic_id":"AN0827","source_url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0827","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0079/"},{"component_id":"DC0054","component":"Drive Access","name":"auditd:SYSCALL","channel":"write syscalls to /dev/sd* targeting offset 0","platforms":["Linux"],"analytic_id":"AN0828","source_url":"https://attack.mitre.org/detectionstrategies/DET0297#AN0828","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0054/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:EXECVE","channel":"Execution of dd/sgdisk with arguments writing to secto
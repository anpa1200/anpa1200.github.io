{"key":"enterprise/T1057","id":"T1057","name":"Process Discovery","domain":"enterprise","level":"technique","parent_id":null,"tactics":["discovery"],"platforms":["ESXi","Linux","macOS","Network Devices","Windows"],"environments":["cloud-hosted-endpoint","network-infrastructure","onprem","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may attempt to get information about running processes on a system. Information obtained could be used to gain an understanding of common software/applications running on systems within the network. Administrator or otherwise elevated access may provide better process details. Adversaries may use the information from Process Discovery during automated discovery to shape follow-on behaviors, including whether or not the adversary…","source_url":"https://attack.mitre.org/techniques/T1057","source_stix_id":"attack-pattern--8f4a33ec-8b1f-4b80-a2f6-642b2e479580","source_modified":"2026-05-12T15:12:00.705Z","source_object_version":"1.6","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0055","name":"File Access","url":"https://attack.mitre.org/datacomponents/DC0055","stix_id":"x-mitre-data-component--235b7491-2d2b-4617-9a52-3c0783680f71","page":"telemetry/DC0055/"},{"id":"DC0035","name":"Process Access","url":"https://attack.mitre.org/datacomponents/DC0035","stix_id":"x-mitre-data-component--1887a270-576a-4049-84de-ef746b2572d6","page":"telemetry/DC0035/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0034","name":"Process Metadata","url":"https://attack.mitre.org/datacomponents/DC0034","stix_id":"x-mitre-data-component--ee575f4a-2d
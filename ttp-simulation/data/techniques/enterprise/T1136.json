{"key":"enterprise/T1136","id":"T1136","name":"Create Account","domain":"enterprise","level":"technique","parent_id":null,"tactics":["persistence"],"platforms":["Windows","IaaS","Linux","macOS","Network Devices","Containers","SaaS","Office Suite","Identity Provider","ESXi"],"environments":["cloud","cloud-hosted-endpoint","containers","identity","network-infrastructure","onprem","saas","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may create an account to maintain access to victim systems. With a sufficient level of access, creating such accounts may be used to establish secondary credentialed access that do not require persistent remote access tools to be deployed on the system. Accounts may be created on the local system or within a domain or cloud tenant. In cloud environments, adversaries may create accounts that only have access to specific services,…","source_url":"https://attack.mitre.org/techniques/T1136","source_stix_id":"attack-pattern--e01be9c5-e763-4caf-aeb7-000b416aef67","source_modified":"2025-10-24T17:49:30.136Z","source_object_version":"2.6","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0061","name":"File Modification","url":"https://attack.mitre.org/datacomponents/DC0061","stix_id":"x-mitre-data-component--84572de3-9583-4c73-aabd-06ea88123dd8","page":"telemetry/DC0061/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0014","name":"User Account Creation","url":"https://attack.mitre.org/datacomponents/DC0014","stix_id":"x-mitre-data-component--deb22295-7e37-4a3b-ac6f-c86666fbe63d","page":"telemetry/DC0014/"},{"id":"DC0010","name":"User Account Modification","url":"https://attack.mitre.org/datacomponents/DC0010","stix_id":"x-mitre-data-component--d27b0089-2c39-4b6c-84ff-303e48657e77","page":"telemetry/DC0010/"}],"strategies":[{"id":"DET0583","name":"Detection Strategy for T1136 - Create Account across platforms","url":"https://attack.mitre.org/detectionstrategies/DET0583","stix_id":"x-mitre-detection-strategy--552bacaa-9df5-4c95-83de-a7d1948003b5","relationship_id":"relationship--bd9b60eb-dc7a-4806-b882-040b17e4f5b4"}],"analytics":[{"id":"AN1604","name":"Analytic 1604","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","guidance":"Adversary uses built-in OS tools or API calls to create local or domain accounts for persistence or lateral movement. Tools such as 'net user', PowerShell, or MMC snap-ins may be used. Detection focuses on Event ID 4720 paired with process lineage and user context.","platforms":["Windows"],"strategy_id":"DET0583"},{"id":"AN1605","name":"Analytic 1605","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","guidance":"Adversary invokes 'useradd', 'adduser', or equivalent system commands or scripts to create local users. Detection focuses on command execution and audit trail of passwd/shadow file modifications.","platforms":["Linux"],"strategy_id":"DET0583"},{"id":"AN1606","name":"Analytic 1606","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1606","guidance":"Adversary creates new users using 'dscl' commands, GUI tools, or by modifying user plist files. Detection includes monitoring dscl invocation and user-related plist changes.","platforms":["macOS"],"strategy_id":"DET0583"},{"id":"AN1607","name":"Analytic 1607","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1607","guidance":"Adversary creates users via IAM/IdP API or portal (e.g., Azure AD, Okta). Detection involves monitoring API calls, admin action logs, and correlation with role assignments.","platforms":["Identity Provider"],"strategy_id":"DET0583"},{"id":"AN1608","name":"Analytic 1608","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1608","guidance":"Account creation via cloud service APIs or CLI, often associated with key generation. Monitored via CloudTrail or equivalent audit logs.","platforms":["IaaS"],"strategy_id":"DET0583"}],"log_sources":[{"component_id":"DC0014","component":"User Account Creation","name":"WinEventLog:Security","channel":"EventCode=4720","platforms":["Windows"],"analytic_id":"AN1604","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1604","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0014","component":"User Account Creation","name":"auditd:SYSCALL","channel":"useradd or adduser executed","platforms":["Linux"],"analytic_id":"AN1605","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"chmod/chown to /etc/passwd or /etc/shadow","platforms":["Linux"],"analytic_id":"AN1605","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0064","component":"Command Execution","name":"macos:unifiedlog","channel":"dscl . -create","platforms":["macOS"],"analytic_id":"AN1606","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1606","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":
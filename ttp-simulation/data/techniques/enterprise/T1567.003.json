{"key":"enterprise/T1567.003","id":"T1567.003","name":"Exfiltration to Text Storage Sites","domain":"enterprise","level":"subtechnique","parent_id":"T1567","tactics":["exfiltration"],"platforms":["Linux","macOS","Windows","ESXi"],"environments":["cloud-hosted-endpoint","onprem","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may exfiltrate data to text storage sites instead of their primary command and control channel. Text storage sites, such as pastebin[.]com, are commonly used by developers to share code and other information. Text storage sites are often used to host malicious code for C2 communication (e.g., Stage Capabilities), but adversaries may also use these sites to exfiltrate collected data. Furthermore, paid features and encryption options…","source_url":"https://attack.mitre.org/techniques/T1567/003","source_stix_id":"attack-pattern--ba04e672-da86-4e69-aa15-0eca5db25f43","source_modified":"2025-04-15T19:59:01.716Z","source_object_version":"1.1","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0055","name":"File Access","url":"https://attack.mitre.org/datacomponents/DC0055","stix_id":"x-mitre-data-component--235b7491-2d2b-4617-9a52-3c0783680f71","page":"telemetry/DC0055/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0078","name":"Network Traffic Flow","url":"https://attack.mitre.org/datacomponents/DC0078","stix_id":"x-mitre-data-component--a7f22107-02e5-4982-9067-6625d4a1765a","page":"telemetry/DC0078/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0284","name":"Detection Strategy for Exfiltration to Text Storage Sites","url":"https://attack.mitre.org/detectionstrategies/DET0284","stix_id":"x-mitre-detection-strategy--6ab41bc0-2d89-4173-8149-728fbc2698b6","relationship_id":"relationship--7478c9f5-d7a9-4423-9c1f-228bac8eb739"}],"analytics":[{"id":"AN0787","name":"Analytic 0787","url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0787","guidance":"Unexpected processes (e.g., powershell.exe, wscript.exe, office apps) initiating HTTP POST/PUT requests to text storage domains like pastebin.com or hastebin.com, particularly when preceded by file access in sensitive directories. Defender perspective: correlation of process lineage, large clipboard/file read operations, and outbound uploads to text storage services.","platforms":["Windows"],"strategy_id":"DET0284"},{"id":"AN0788","name":"Analytic 0788","url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0788","guidance":"Use of curl, wget, or custom scripts to POST data to pastebin-like services. Defender perspective: identify chained behavior where files are compressed/read followed by HTTPS POST requests to text-sharing endpoints.","platforms":["Linux"],"strategy_id":"DET0284"},{"id":"AN0789","name":"Analytic 0789","url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0789","guidance":"Processes such as osascript, curl, or office applications sending data to text storage APIs/domains. Defender perspective: anomalous clipboard or file reads by unexpected applications immediately followed by outbound HTTPS requests to pastebin-like services.","platforms":["macOS"],"strategy_id":"DET0284"},{"id":"AN0790","name":"Analytic 0790","url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0790","guidance":"ESXi services (vmx, hostd) generating outbound HTTPS POST requests to text storage sites. Defender perspective: anomalous datastore or log reads chained with traffic to pastebin-like destinations.","platforms":["ESXi"],"strategy_id":"DET0284"}],"log_sources":[{"component_id":"DC0055","component":"File Access","name":"WinEventLog:Security","channel":"EventCode=4663, 4670, 4656","platforms":["Windows"],"analytic_id":"AN0787","source_url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0787","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN0787","source_url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0787","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0787","source_url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0787","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0064","component":"Command Execution","name":"auditd:EXECVE","channel":"curl -d, wget --post-data","platforms":["Linux"],"analytic_id":"AN0788","source_url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0788","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"read/open of sensitive file directories","platforms":["Linux"],"analytic_id":"AN0788","source_url":"https://attack.mitre.org/detectionstrategies/DET0284#AN0788","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"co
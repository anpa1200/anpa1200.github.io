{"key":"enterprise/T1496.001","id":"T1496.001","name":"Compute Hijacking","domain":"enterprise","level":"subtechnique","parent_id":"T1496","tactics":["impact"],"platforms":["Windows","IaaS","Linux","macOS","Containers"],"environments":["cloud","cloud-hosted-endpoint","containers","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may leverage the compute resources of co-opted systems to complete resource-intensive tasks, which may impact system and/or hosted service availability. One common purpose for Compute Hijacking is to validate transactions of cryptocurrency networks and earn virtual currency. Adversaries may consume enough system resources to negatively impact and/or cause affected machines to become unresponsive. Servers and cloud-based systems are…","source_url":"https://attack.mitre.org/techniques/T1496/001","source_stix_id":"attack-pattern--a718a0c8-5768-41a1-9958-a1cc3f995e99","source_modified":"2025-04-15T22:08:46.014Z","source_object_version":"1.0","telemetry":{"status":"mapped","components":[{"id":"DC0072","name":"Container Creation","url":"https://attack.mitre.org/datacomponents/DC0072","stix_id":"x-mitre-data-component--a5ae90ca-0c4b-481c-959f-0eb18a7ff953","page":"telemetry/DC0072/"},{"id":"DC0018","name":"Host Status","url":"https://attack.mitre.org/datacomponents/DC0018","stix_id":"x-mitre-data-component--85a533a4-5fa4-4dba-b45d-f0717bedd6e6","page":"telemetry/DC0018/"},{"id":"DC0080","name":"Instance Start","url":"https://attack.mitre.org/datacomponents/DC0080","stix_id":"x-mitre-data-component--f8213cde-6b3a-420d-9ab7-41c9af1a919f","page":"telemetry/DC0080/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0078","name":"Network Traffic Flow","url":"https://attack.mitre.org/datacomponents/DC0078","stix_id":"x-mitre-data-component--a7f22107-02e5-4982-9067-6625d4a1765a","page":"telemetry/DC0078/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0001","name":"Scheduled Job Creation","url":"https://attack.mitre.org/datacomponents/DC0001","stix_id":"x-mitre-data-component--f42df6f0-6395-4f0c-9376-525a031f00c3","page":"telemetry/DC0001/"}],"strategies":[{"id":"DET0540","name":"Multi-Platform Behavioral Detection for Compute Hijacking","url":"https://attack.mitre.org/detectionstrategies/DET0540","stix_id":"x-mitre-detection-strategy--be288974-9b74-41c1-8c43-66aef169255a","relationship_id":"relationship--9176ca84-16bf-4a60-bce5-ffa6093c8145"}],"analytics":[{"id":"AN1489","name":"Analytic 1489","url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1489","guidance":"Sustained execution of resource-intensive processes (e.g., cryptocurrency miners), often launched via scheduled tasks, WMI, or PowerShell. These processes frequently establish persistent external connections and attempt to evade detection using masqueraded or renamed binaries.","platforms":["Windows"],"strategy_id":"DET0540"},{"id":"AN1490","name":"Analytic 1490","url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1490","guidance":"Unusual long-running processes consuming high CPU cycles (e.g., via 'top' or 'ps') initiated via cron, shell scripts, or Docker. Connections to known mining pools or DNS over HTTPS usage as evasion.","platforms":["Linux"],"strategy_id":"DET0540"},{"id":"AN1491","name":"Analytic 1491","url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1491","guidance":"Persistent or background daemons (e.g., plist or launchd jobs) spawning high-CPU processes like xmrig or cpuminer. Outbound encrypted traffic to IPs/domains commonly used by mining proxies.","platforms":["macOS"],"strategy_id":"DET0540"},{"id":"AN1492","name":"Analytic 1492","url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1492","guidance":"Ephemeral or unauthorized container instantiation using public images (e.g., from DockerHub) that initiate high CPU usage shortly after startup. Often scheduled via Kubernetes or Docker socket abuse.","platforms":["Containers"],"strategy_id":"DET0540"},{"id":"AN1493","name":"Analytic 1493","url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1493","guidance":"Unauthorized instance creation in unmonitored or unused regions. Burst of compute-intensive jobs in spot instances or sudden spike in resource usage in legitimate VMs.","platforms":["IaaS"],"strategy_id":"DET0540"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1489","source_url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1489","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1489","source_url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1489","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0001","component":"Scheduled Job Creation","name":"WinEventLog:Security","channel":"EventCode=4698","platforms":["Windows"],"analytic_id":"AN1489","source_url":"https://attack.mitre.org/detectionstrategies/DET0540#AN1489","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0001/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"a
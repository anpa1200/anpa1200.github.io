{"key":"enterprise/T1538","id":"T1538","name":"Cloud Service Dashboard","domain":"enterprise","level":"technique","parent_id":null,"tactics":["discovery"],"platforms":["IaaS","SaaS","Office Suite","Identity Provider"],"environments":["cloud","identity","onprem","saas"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"An adversary may use a cloud service dashboard GUI with stolen credentials to gain useful information from an operational cloud environment, such as specific services, resources, and features. For example, the GCP Command Center can be used to view all assets, review findings of potential security risks, and run additional queries, such as finding public IP addresses and open ports. Depending on the configuration of the environment, an adversary…","source_url":"https://attack.mitre.org/techniques/T1538","source_stix_id":"attack-pattern--e49920b0-6c54-40c1-9571-73723653205f","source_modified":"2025-10-24T17:49:32.022Z","source_object_version":"1.5","telemetry":{"status":"mapped","components":[{"id":"DC0038","name":"Application Log Content","url":"https://attack.mitre.org/datacomponents/DC0038","stix_id":"x-mitre-data-component--9c2fa0ae-7abc-485a-97f6-699e3b6cf9fa","page":"telemetry/DC0038/"},{"id":"DC0027","name":"Cloud Storage Metadata","url":"https://attack.mitre.org/datacomponents/DC0027","stix_id":"x-mitre-data-component--e214eb6d-de8f-4154-9015-6d47915fbed1","page":"telemetry/DC0027/"},{"id":"DC0067","name":"Logon Session Creation","url":"https://attack.mitre.org/datacomponents/DC0067","stix_id":"x-mitre-data-component--9ce98c86-8d30-4043-ba54-0784d478d0b5","page":"telemetry/DC0067/"},{"id":"DC0002","name":"User Account Authentication","url":"https://attack.mitre.org/datacomponents/DC0002","stix_id":"x-mitre-data-component--a953ca55-921a-44f7-9b8d-3d40141aa17e","page":"telemetry/DC0002/"}],"strategies":[{"id":"DET0291","name":"Detection of Cloud Service Dashboard Usage via GUI-Based Cloud Access","url":"https://attack.mitre.org/detectionstrategies/DET0291","stix_id":"x-mitre-detection-strategy--e2bf0a76-b5e4-4a23-adbb-024454f5dbdc","relationship_id":"relationship--3773ce57-ad3c-47ae-8484-6a42338dddf4"}],"analytics":[{"id":"AN0808","name":"Analytic 0808","url":"https://attack.mitre.org/detectionstrategies/DET0291#AN0808","guidance":"Detects web console login events followed by read-only or metadata retrieval activity from GUI sources (e.g., browser session, mobile client) rather than API/CLI sources. Correlates across CloudTrail, IAM identity logs, and user-agent context.","platforms":["IaaS"],"strategy_id":"DET0291"},{"id":"AN0809","name":"Analytic 0809","url":"https://attack.mitre.org/detectionstrategies/DET0291#AN0809","guidance":"Detects successful login to cloud identity portals (e.g., Okta, Azure AD, Google Identity) from atypical geolocations, devices, or user agents immediately followed by dashboard/portal navigation to sensitive pages such as user or app configuration.","platforms":["Identity Provider"],"strategy_id":"DET0291"},{"id":"AN0810","name":"Analytic 0810","url":"https://attack.mitre.org/detectionstrategies/DET0291#AN0810","guidance":"Detects login to admin consoles (e.g., Microsoft 365 Admin Center) from unrecognized users, devices, or geolocations followed by non-API data review or configuration read actions that suggest GUI dashboard use.","platforms":["Office Suite"],"strategy_id":"DET0291"},{"id":"AN0811","name":"Analytic 0811","url":"https://attack.mitre.org/detectionstrategies/DET0291#AN0811","guidance":"Detects SaaS web login followed by dashboard or web GUI page views from unfamiliar locations, devices, or access patterns. Identifies use of sensitive reporting or configuration consoles accessed from high-risk accounts.","platforms":["SaaS"],"strategy_id":"DET0291"}],"log_sources":[{"component_id":"DC0067","component":"Logon Session Creation","name":"AWS:CloudTrail","channel":"ConsoleLogin","platforms":["IaaS"],"analytic_id":"AN0808","source_url":"https://atta
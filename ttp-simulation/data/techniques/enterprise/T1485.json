{"key":"enterprise/T1485","id":"T1485","name":"Data Destruction","domain":"enterprise","level":"technique","parent_id":null,"tactics":["impact"],"platforms":["Containers","ESXi","IaaS","Linux","macOS","Windows"],"environments":["cloud","cloud-hosted-endpoint","containers","onprem","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may destroy data and files on specific systems or in large numbers on a network to interrupt availability to systems, services, and network resources. Data destruction is likely to render stored data irrecoverable by forensic techniques through overwriting files or data on local and remote drives. Common operating system file deletion commands such as del and rm often only remove pointers to files without wiping the contents of the…","source_url":"https://attack.mitre.org/techniques/T1485","source_stix_id":"attack-pattern--d45a3d09-b3cf-48f4-9f0f-f521ee5cb05c","source_modified":"2026-05-12T15:12:00.717Z","source_object_version":"1.4","telemetry":{"status":"mapped","components":[{"id":"DC0022","name":"Cloud Storage Deletion","url":"https://attack.mitre.org/datacomponents/DC0022","stix_id":"x-mitre-data-component--4c41e296-b8d2-4a37-b789-eb565c87c00c","page":"telemetry/DC0022/"},{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0039","name":"File Creation","url":"https://attack.mitre.org/datacomponents/DC0039","stix_id":"x-mitre-data-component--2b3bfe19-d59a-460d-93bb-2f546adc2d2c","page":"telemetry/DC0039/"},{"id":"DC0040","name":"File Deletion","url":"https://attack.mitre.org/datacomponents/DC0040","stix_id":"x-mitre-data-component--e905dad2-00d6-477c-97e8-800427abd0e8","page":"telemetry/DC0040/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"},{"id":"DC0033","name":"Process Termination","url":"https://attack.mitre.org/datacomponents/DC0033","stix_id":"x-mitre-data-component--61f1d40e-f3d0-4cc6-aa2d-937b6204194f","page":"telemetry/DC0033/"},{"id":"DC0098","name":"Volume Deletion","url":"https://attack.mitre.org/datacomponents/DC0098","stix_id":"x-mitre-data-component--3acecdde-c327-4498-9bb8-33a2e63c6c57","page":"telemetry/DC0098/"}],"strategies":[{"id":"DET0146","name":"Detection of Data Destruction Across Platforms via Mass Overwrite and Deletion Patterns","url":"https://attack.mitre.org/detectionstrategies/DET0146","stix_id":"x-mitre-detection-strategy--c54fdf95-c7ac-4ca4-bd99-273e56da20a5","relationship_id":"relationship--31ece083-4856-4057-bfca-5dd17221b34b"}],"analytics":[{"id":"AN0411","name":"Analytic 0411","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","guidance":"Adversary spawns command-line tools (e.g., del, cipher /w, SDelete) or scripts to recursively delete or overwrite user/system files. This may be correlated with abnormal file IO activity, registry writes, or tampering in critical system directories.","platforms":["Windows"],"strategy_id":"DET0146"},{"id":"AN0412","name":"Analytic 0412","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0412","guidance":"Massive recursive deletions or overwrites via `rm -rf`, `shred`, `dd`, or wiper binaries. May include unlink syscalls, deletion of known config/data paths, or sequential overwrite patterns.","platforms":["Linux"],"strategy_id":"DET0146"},{"id":"AN0413","name":"Analytic 0413","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0413","guidance":"Destruction via `rm -rf`, overwrite with `dd` or `srm`, often executed by script in /tmp or /private/tmp, may also involve file overwrite to political or decoy image data.","platforms":["macOS"],"strategy_id":"DET0146"},{"id":"AN0414","name":"Analytic 0414","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0414","guidance":"Adversary deletes critical infrastructure: EC2 instances, S3 buckets, snapshots, or volumes using elevated IAM credentials. Frequently includes batch API calls with `Delete*` or `TerminateInstances`.","platforms":["IaaS"],"strategy_id":"DET0146"},{"id":"AN0415","name":"Analytic 0415","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0415","guidance":"Adversary destroys virtual disks (VMDK), images, or VMs by invoking `vim-cmd`, deleting datastore contents, or purging snapshots.","platforms":["ESXi"],"strategy_id":"DET0146"},{"id":"AN0416","name":"Analytic 0416","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0416","guidance":"Container process executes destructive file operations inside volume mounts or host paths. Includes `rm -rf /mnt/volumes/`, container breakout followed by host deletion attempts.","platforms":["Containers"],"strategy_id":"DET0146"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0040","component":"File Deletion","name":"WinEventLog:Sysmon","channel":"EventCode=23","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"},{"component_id":"DC0040","component":"File Deletion","name":"auditd:SYSCALL","channe
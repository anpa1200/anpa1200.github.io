{"key":"enterprise/T1567","id":"T1567","name":"Exfiltration Over Web Service","domain":"enterprise","level":"technique","parent_id":null,"tactics":["exfiltration"],"platforms":["ESXi","Linux","macOS","Office Suite","SaaS","Windows"],"environments":["cloud","cloud-hosted-endpoint","onprem","saas","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may use an existing, legitimate external Web service to exfiltrate data rather than their primary command and control channel. Popular Web services acting as an exfiltration mechanism may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to compromise. Firewall rules may also already exist to permit traffic to these services. Web service providers also…","source_url":"https://attack.mitre.org/techniques/T1567","source_stix_id":"attack-pattern--40597f16-0963-4249-bf4c-ac93b7fb9807","source_modified":"2026-05-12T15:12:00.628Z","source_object_version":"1.5","telemetry":{"status":"mapped","components":[{"id":"DC0038","name":"Application Log Content","url":"https://attack.mitre.org/datacomponents/DC0038","stix_id":"x-mitre-data-component--9c2fa0ae-7abc-485a-97f6-699e3b6cf9fa","page":"telemetry/DC0038/"},{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0055","name":"File Access","url":"https://attack.mitre.org/datacomponents/DC0055","stix_id":"x-mitre-data-component--235b7491-2d2b-4617-9a52-3c0783680f71","page":"telemetry/DC0055/"},{"id":"DC0039","name":"File Creation","url":"https://attack.mitre.org/datacomponents/DC0039","stix_id":"x-mitre-data-component--2b3bfe19-d59a-460d-93bb-2f546adc2d2c","page":"telemetry/DC0039/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0078","name":"Network Traffic Flow","url":"https://attack.mitre.org/datacomponents/DC0078","stix_id":"x-mitre-data-component--a7f22107-02e5-4982-9067-6625d4a1765a","page":"telemetry/DC0078/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0548","name":"Detection Strategy for Exfiltration Over Web Service","url":"https://attack.mitre.org/detectionstrategies/DET0548","stix_id":"x-mitre-detection-strategy--1753ab98-4530-4284-9bc3-5d4813abfb9e","relationship_id":"relationship--2d284ff6-5204-4bde-b4f5-c172dd4c4ca3"}],"analytics":[{"id":"AN1511","name":"Analytic 1511","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1511","guidance":"Processes that normally do not initiate network communications suddenly making outbound HTTPS connections with high outbound-to-inbound data ratios. Defender view: correlation between process creation logs (e.g., Word, Excel, PowerShell) and subsequent anomalous network traffic volumes toward common web services (Dropbox, Google Drive, OneDrive).","platforms":["Windows"],"strategy_id":"DET0548"},{"id":"AN1512","name":"Analytic 1512","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","guidance":"Processes (tar, curl, python scripts) accessing large file sets and initiating outbound HTTPS POST requests with payload sizes inconsistent with baseline activity. Defender perspective: detect abnormal sequence of file archival followed by encrypted uploads to external web services.","platforms":["Linux"],"strategy_id":"DET0548"},{"id":"AN1513","name":"Analytic 1513","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","guidance":"Office apps or scripts writing files followed by xattr manipulation (to evade quarantine) and subsequent HTTPS uploads. Defender perspective: anomalous file modification + outbound TLS traffic originating from non-networking apps (Word, Excel, Preview).","platforms":["macOS"],"strategy_id":"DET0548"},{"id":"AN1514","name":"Analytic 1514","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1514","guidance":"Abnormal API calls from user accounts invoking file upload endpoints outside normal baselines (M365, Google Drive, Box). Defender perspective: monitor unified audit logs for elevated frequency of Upload, Create, or Copy operations from compromised accounts.","platforms":["SaaS"],"strategy_id":"DET0548"},{"id":"AN1515","name":"Analytic 1515","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1515","guidance":"ESXi guest OS or management interface processes establishing unexpected external HTTPS connections. Defender perspective: monitor vmx or hostd processes making outbound web requests with significant data transfer.","platforms":["ESXi"],"strategy_id":"DET0548"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN1511","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1511","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1511","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1511","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN1511","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1511","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0064","component":"Command Execution","name":"auditd:EXECVE","channel":"curl or wget with POST/PUT options","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"open/read of sensitive directories (/etc, /home/*)","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"NSM:Flow","channel":"sustained outbound HTTPS sessions with high data volume","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"execution of Office binaries with network activity","platforms":["macOS"],"analytic_id":"AN1513","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0055","component":"File Access","name":"macos:unifiedlog","channel":"read/write of user documents prior to upload","platforms":["macOS"],"analytic_id":"AN1513","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0085","component":"
{"key":"enterprise/T1071.005","id":"T1071.005","name":"Publish/Subscribe Protocols","domain":"enterprise","level":"subtechnique","parent_id":"T1071","tactics":["command-and-control"],"platforms":["macOS","Linux","Windows","Network Devices"],"environments":["cloud-hosted-endpoint","network-infrastructure","onprem"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may communicate using publish/subscribe (pub/sub) application layer protocols to avoid detection/network filtering by blending in with existing traffic. Commands to the remote system, and often the results of those commands, will be embedded within the protocol traffic between the client and server. Protocols such as MQTT, XMPP, AMQP, and STOMP use a publish/subscribe design, with message distribution managed by a centralized broker.…","source_url":"https://attack.mitre.org/techniques/T1071/005","source_stix_id":"attack-pattern--241f9ea8-f6ae-4f38-92f5-cef5b7e539dd","source_modified":"2025-04-15T19:58:14.152Z","source_object_version":"1.1","telemetry":{"status":"mapped","components":[{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0078","name":"Network Traffic Flow","url":"https://attack.mitre.org/datacomponents/DC0078","stix_id":"x-mitre-data-component--a7f22107-02e5-4982-9067-6625d4a1765a","page":"telemetry/DC0078/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0002","name":"Behavioral Detection of Publish/Subscribe Protocol Misuse for C2","url":"https://attack.mitre.org/detectionstrategies/DET0002","stix_id":"x-mitre-detection-strategy--16495e17-03ec-4e11-ab80-f76ed6386329","relationship_id":"relationship--116eaf8e-1aed-4455-b28c-4b8c74acd21d"}],"analytics":[{"id":"AN0002","name":"Analytic 0002","url":"https://attack.mitre.org/detectionstrategies/DET0002#AN0002","guidance":"Detects non-standard processes (e.g., PowerShell, python.exe, rundll32.exe) making outbound connections using publish/subscribe protocols (e.g., MQTT, AMQP) over non-browser, encrypted channels, often beaconing to message brokers.","platforms":["Windows"],"strategy_id":"DET0002"},{"id":"AN0003","name":"Analytic 0003","url":"https://attack.mitre.org/detectionstrategies/DET0002#AN0003","guidance":"Detects CLI tools (e.g., mosquitto_pub, nc, python scripts) interacting with pub/sub brokers using unusual topic names, high-frequency publication rates, or obfuscated payloads to non-standard hosts.","platforms":["Linux"],"strategy_id":"DET0002"},{"id":"AN0004","name":"Analytic 0004","url":"https://attack.mitre.org/detectionstrategies/DET0002#AN0004","guidance":"Detects osascript, curl, or custom binaries interacting with XMPP/MQTT brokers in unapproved destinations with encrypted payloads or frequent POST-like requests to broker URIs.","platforms":["macOS"],"strategy_id":"DET0002"},{"id":"AN0005","name":"Analytic 0005","url":"https://attack.mitre.org/detectionstrategies/DET0002#AN0005","guidance":"Detects pub/sub traffic over unusual ports, high-frequency topic publications, and connections to known-bad or dynamic broker endpoints outside allowlisted infrastructure.","platforms":["Network Devices"],"strategy_id":"DET0002"}],"log_sources":[{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN0002","source_url":"https://attack.mitre.org/detectionstrategies/DET0002#AN0002","validation":"upstream_definition_not_locally_val
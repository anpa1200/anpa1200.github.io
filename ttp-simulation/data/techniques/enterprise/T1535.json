{"key":"enterprise/T1535","id":"T1535","name":"Unused/Unsupported Cloud Regions","domain":"enterprise","level":"technique","parent_id":null,"tactics":["stealth"],"platforms":["IaaS"],"environments":["cloud"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may create cloud instances in unused geographic service regions in order to evade detection. Access is usually obtained through compromising accounts used to manage cloud infrastructure. Cloud service providers often provide infrastructure throughout the world in order to improve performance, provide redundancy, and allow customers to meet compliance requirements. Oftentimes, a customer will only use a subset of the available regions…","source_url":"https://attack.mitre.org/techniques/T1535","source_stix_id":"attack-pattern--59bd0dec-f8b2-4b9a-9141-37a1e6899761","source_modified":"2026-05-12T15:12:00.635Z","source_object_version":"2.0","telemetry":{"status":"mapped","components":[{"id":"DC0024","name":"Cloud Storage Creation","url":"https://attack.mitre.org/datacomponents/DC0024","stix_id":"x-mitre-data-component--59ec10d9-546b-4b8e-bccb-fa85f71e5055","page":"telemetry/DC0024/"},{"id":"DC0080","name":"Instance Start","url":"https://attack.mitre.org/datacomponents/DC0080","stix_id":"x-mitre-data-component--f8213cde-6b3a-420d-9ab7-41c9af1a919f","page":"telemetry/DC0080/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0013","name":"User Account Metadata","url":"https://attack.mitre.org/datacomponents/DC0013","stix_id":"x-mitre-data-component--b5d0492b-cda4-421c-8e51-ed2b8d85c5d0","page":"telemetry/DC0013/"}],"strategies":[{"id":"DET0247","name":"Detection of Adversary Use of Unused or Unsupported Cloud Regions (IaaS)","url":"https://attack.mitre.org/detectionstrategies/DET0247","stix_id":"x-mitre-detection-strate
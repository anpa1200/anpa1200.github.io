{"key":"enterprise/T1140","id":"T1140","name":"Deobfuscate/Decode Files or Information","domain":"enterprise","level":"technique","parent_id":null,"tactics":["stealth"],"platforms":["ESXi","Linux","macOS","Windows"],"environments":["cloud-hosted-endpoint","onprem","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may use Obfuscated Files or Information to hide artifacts of an intrusion from analysis. They may require separate mechanisms to decode or deobfuscate that information depending on how they intend to use it. Methods for doing that include built-in functionality of malware or by using utilities present on the system. One such example is the use of certutil to decode a remote access tool portable executable file that has been hidden…","source_url":"https://attack.mitre.org/techniques/T1140","source_stix_id":"attack-pattern--3ccef7ae-cb5e-48f6-8302-897105fbf55c","source_modified":"2026-05-12T15:12:00.628Z","source_object_version":"2.0","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0039","name":"File Creation","url":"https://attack.mitre.org/datacomponents/DC0039","stix_id":"x-mitre-data-component--2b3bfe19-d59a-460d-93bb-2f546adc2d2c","page":"telemetry/DC0039/"},{"id":"DC0035","name":"Process Access","url":"https://attack.mitre.org/datacomponents/DC0035","stix_id":"x-mitre-data-component--1887a270-576a-4049-84de-ef746b2572d6","page":"telemetry/DC0035/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0275","name":"Detect Adversary Deobfuscation or Decoding of Files and Payloads","url":"https://attack.mitre.org/detectionstrategies/DET0275","stix_id":"x-mitre-detection-strategy--5b3bf2de-d91e-4272-97a8-5df6f4071e45","relationship_id":"relationship--9c92cb61-d6a7-4dc3-9bf8-1ebcc1b2cc73"}],"analytics":[{"id":"AN0767","name":"Analytic 0767","url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0767","guidance":"An adversary leverages built-in tools such as certutil.exe, powershell.exe, or copy.exe to decode, reassemble, or extract hidden malicious content from obfuscated containers or encoded formats. The decoding utility often spawns shortly after file staging or download and may be chained with script interpreters or further payload execution.","platforms":["Windows"],"strategy_id":"DET0275"},{"id":"AN0768","name":"Analytic 0768","url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0768","guidance":"The adversary uses native utilities like base64, gzip, tar, or openssl to decode, decompress, or decrypt files that were previously staged or downloaded. These tools may be chained with curl/wget and executed via bash/zsh, often to extract an embedded payload or reverse shell script.","platforms":["Linux"],"strategy_id":"DET0275"},{"id":"AN0769","name":"Analytic 0769","url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0769","guidance":"The adversary invokes built-in scripting or decoding tools like base64, plutil, or AppleScript-based utilities to decode files embedded in staging artifacts. Decoding often occurs post-download or as part of post-exploitation payload deployment via zsh, python, or osascript.","platforms":["macOS"],"strategy_id":"DET0275"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0767","source_url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0767","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0767","source_url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0767","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN0767","source_url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0767","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"},{"component_id":"DC0064","component":"Command Execution","name":"auditd:SYSCALL","channel":"bash/zsh of base64, tar, gzip, or openssl immediately after file write","platforms":["Linux"],"analytic_id":"AN0768","source_url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0768","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0064","component":"Command Execution","name":"macos:unifiedlog","channel":"base64 -d or osascript invoked on staged file","platforms":["macOS"],"analytic_id":"AN0769","source_url":"https://attack.mitre.org/detectionstrategies/DET0275#AN0769","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"}],"unresolved_references":[],"basis":"ATT&CK detects relationship → detection strategy → analytic → log-source component reference","planning_inputs":[],"visibility":"source_mapped","planning_references":[],"references":[{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0035","name":"Process Access","tag":"Process Access","page":"telemetry/DC0035/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}]},"simulation":
{"key":"enterprise/T1567.002","id":"T1567.002","name":"Exfiltration to Cloud Storage","domain":"enterprise","level":"subtechnique","parent_id":"T1567","tactics":["exfiltration"],"platforms":["ESXi","Linux","macOS","Windows"],"environments":["cloud-hosted-endpoint","onprem","virtualization"],"environment_basis":"project_taxonomy_from_upstream_platforms","summary":"Adversaries may exfiltrate data to a cloud storage service rather than over their primary command and control channel. Cloud storage services allow for the storage, edit, and retrieval of data from a remote cloud storage server over the Internet. Examples of cloud storage services include Dropbox and Google Docs. Exfiltration to these cloud storage services can provide a significant amount of cover to the adversary if hosts within the network…","source_url":"https://attack.mitre.org/techniques/T1567/002","source_stix_id":"attack-pattern--bf1b6176-597c-4600-bfcd-ac989670f96b","source_modified":"2026-05-12T15:12:00.713Z","source_object_version":"1.3","telemetry":{"status":"mapped","components":[{"id":"DC0064","name":"Command Execution","url":"https://attack.mitre.org/datacomponents/DC0064","stix_id":"x-mitre-data-component--685f917a-e95e-4ba0-ade1-c7d354dae6e0","page":"telemetry/DC0064/"},{"id":"DC0055","name":"File Access","url":"https://attack.mitre.org/datacomponents/DC0055","stix_id":"x-mitre-data-component--235b7491-2d2b-4617-9a52-3c0783680f71","page":"telemetry/DC0055/"},{"id":"DC0082","name":"Network Connection Creation","url":"https://attack.mitre.org/datacomponents/DC0082","stix_id":"x-mitre-data-component--181a9f8c-c780-4f1f-91a8-edb770e904ba","page":"telemetry/DC0082/"},{"id":"DC0085","name":"Network Traffic Content","url":"https://attack.mitre.org/datacomponents/DC0085","stix_id":"x-mitre-data-component--3772e279-27d6-477a-9fe3-c6beb363594c","page":"telemetry/DC0085/"},{"id":"DC0078","name":"Network Traffic Flow","url":"https://attack.mitre.org/datacomponents/DC0078","stix_id":"x-mitre-data-component--a7f22107-02e5-4982-9067-6625d4a1765a","page":"telemetry/DC0078/"},{"id":"DC0032","name":"Process Creation","url":"https://attack.mitre.org/datacomponents/DC0032","stix_id":"x-mitre-data-component--3d20385b-24ef-40e1-9f56-f39750379077","page":"telemetry/DC0032/"}],"strategies":[{"id":"DET0570","name":"Detection Strategy for Exfiltration to Cloud Storage","url":"https://attack.mitre.org/detectionstrategies/DET0570","stix_id":"x-mitre-detection-strategy--c8895822-a3d1-41eb-952f-c67b4673eee2","relationship_id":"relationship--6d01d586-c518-45db-96f3-5b718324c9da"}],"analytics":[{"id":"AN1571","name":"Analytic 1571","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","guidance":"Unusual processes (e.g., powershell.exe, excel.exe) accessing large local files and subsequently initiating HTTPS POST requests to domains associated with cloud storage services (e.g., dropbox.com, drive.google.com, box.com). Defender perspective: correlation between file reads in sensitive directories and high outbound traffic volume to known storage APIs.","platforms":["Windows"],"strategy_id":"DET0570"},{"id":"AN1572","name":"Analytic 1572","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","guidance":"Processes such as curl, wget, rclone, or custom scripts executing uploads to cloud storage endpoints. Defender perspective: detect chained events where tar/gzip is executed to compress files followed by HTTPS PUT/POST requests to known storage services.","platforms":["Linux"],"strategy_id":"DET0570"},{"id":"AN1573","name":"Analytic 1573","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1573","guidance":"Applications or scripts invoking cloud storage APIs (Dropbox sync, iCloud, Google Drive client) in unexpected contexts. Defender perspective: detect sensitive file reads by non-standard applications followed by unusual encrypted uploads to external cloud storage domains.","platforms":["macOS"],"strategy_id":"DET0570"},{"id":"AN1574","name":"Analytic 1574","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1574","guidance":"Unusual ESXi processes (vmx, hostd) reading datastore files and generating outbound HTTPS traffic toward external cloud storage endpoints. Defender perspective: anomalous datastore activity followed by network transfers to Dropbox, AWS S3, or other storage services.","platforms":["ESXi"],"strategy_id":"DET0570"}],"log_sources":[{"component_id":"DC0055","component":"File Access","name":"WinEventLog:Security","channel":"EventCode=4663, 4670, 4656","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0064","component":"Command Execution","name":"auditd:EXECVE","channel":"curl -T, rclone copy","platforms":["Linux"],"analytic_id":"AN1572","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"read/open of sensitive file directories","platforms":["Linux"],"analytic_id":"AN1572","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","val
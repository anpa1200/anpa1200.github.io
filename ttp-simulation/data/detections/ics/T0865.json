{"key":"ics/T0865","id":"T0865","name":"Spearphishing Attachment","domain":"ics","platforms":["None"],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T0865","technique_page":"techniques/ics/T0865/","page":"detections/ics/T0865/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0781","name":"Detection of Spearphishing Attachment","url":"https://attack.mitre.org/detectionstrategies/DET0781","stix_id":"x-mitre-detection-strategy--b817139c-2941-4523-bfb5-10c36d230871","relationship_id":"relationship--165e3427-8738-4a89-9964-4593c671e855","description":"","analytics":[{"id":"AN1913","name":"Analytic 1913","guidance":"Monitor for suspicious descendant process spawning from Microsoft Office and other productivity software. For added context on adversary procedures and background see Spearphishing Attachment.\nMonitor for newly constructed files from a spearphishing emails with a malicious attachment in an attempt to gain access to victim systems.\nMonitor network traffic for suspicious email attachments. Consider correlation with process monitoring and command line to detect anomalous processes execution and command line arguments associated to traffic patterns (e.g., monitor anomalies in use of files that do not normally initiate connections for respective protocol(s)). Use web proxies to review content of emails including sender information, headers, and attachments for potentially malicious content.\nMonitor mail server and proxy logs for evidence of messages originating from spoofed addresses, including records indicating failed DKIM+SPF validation or mismatched message headers. Anti-virus can potentially detect malicious documents and attachments as they're scanned to be stored on the email server or on the user's computer.","url":"https://attack.mitre.org/detectionstrategies/DET0781#AN1913","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"Process","channel":"None","platforms":["None"],"analytic_id":"AN1913","source_url":"https://attack.mitre.org/detectionstrategies/DET0781#AN1913","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0039","component":"File Creation","name":"File","channel":"None","platforms":["None"],"analytic_id":"AN1913","source_url":"https://attack.mitre.org/detectionstrategies/DET0781#AN1913","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"Network Traffic","channel":"None","platforms":["None"],"analytic_id":"AN1913","source_url":"https://attack.mitre.org/detectionstrategies/DET0781#AN1913","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"},{"component_id":"DC0038","component":"Application Log Content","name":"Application Log","channel":"None","platforms":["None"],"analytic_id":"AN1913","source_url":"https://attack.mitre.org/detectionstrategies/DET0781#AN1913","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"}]}]}],"telemetry_references":[{"id":"DC0038","name":"Application Log Content","tag":"Application Log Content","page":"telemetry/DC0038/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0085","name":"Network Traffic Content","tag":"Network Traffic Content","page":"telemetry/DC0085/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[],"related_parent":null,"article_url":"https://1200km.com/articles/read/2026/2026-04-
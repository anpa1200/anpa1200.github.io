{"key":"ics/T1693","id":"T1693","name":"Modify Firmware","domain":"ics","platforms":[],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T1693","technique_page":"techniques/ics/T1693/","page":"detections/ics/T1693/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0904","name":"Detection of Firmware Modification","url":"https://attack.mitre.org/detectionstrategies/DET0904","stix_id":"x-mitre-detection-strategy--73773bb8-c63b-4d48-9b48-33440f12a514","relationship_id":"relationship--3066ddc9-b4e8-41b6-a28f-9de5030cb714","description":"","analytics":[{"id":"AN2047","name":"Analytic 2047","guidance":"Monitor for firmware changes which may be observable via operational alarms from devices.\n\nMonitor device application logs for firmware changes, although not all devices will produce such logs.\n\nMonitor ICS management protocols / file transfer protocols for protocol functions related to firmware changes.\n\nMonitor firmware for unexpected changes. Asset management systems should be consulted to understand known-good firmware versions. Dump and inspect BIOS images on vulnerable systems and compare against known good images. Analyze differences to determine if malicious changes have occurred. Log attempts to read/write to BIOS and compare against known patching behavior. Likewise, EFI modules can be collected and compared against a known-clean list of EFI executable binaries to detect potentially malicious modules. The CHIPSEC framework can be used for analysis to determine if firmware modifications have been performed.","url":"https://attack.mitre.org/detectionstrategies/DET0904#AN2047","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0108","component":"Device Alarm","name":"Operational Databases","channel":"None","platforms":["None"],"analytic_id":"AN2047
{"key":"ics/T1693.002","id":"T1693.002","name":"Module Firmware","domain":"ics","platforms":[],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T1693/002","technique_page":"techniques/ics/T1693.002/","page":"detections/ics/T1693.002/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0790","name":"Detection of Module Firmware","url":"https://attack.mitre.org/detectionstrategies/DET0790","stix_id":"x-mitre-detection-strategy--e69d1e15-76e1-434c-bd45-0354a10dde8a","relationship_id":"relationship--706bf21c-0722-43b3-8729-60370f648796","description":"","analytics":[{"id":"AN1922","name":"Analytic 1922","guidance":"Monitor for firmware changes which may be observable via operational alarms from devices.\nMonitor device application logs for firmware changes, although not all devices will produce such logs.\nMonitor ICS management protocols / file transfer protocols for protocol functions related to firmware changes.\nMonitor firmware for unexpected changes. Asset management systems should be consulted to understand known-good firmware versions. Dump and inspect BIOS images on vulnerable systems and compare against known good images. Analyze differences to determine if malicious changes have occurred. Log attempts to read/write to BIOS and compare against known patching behavior. Likewise, EFI modules can be collected and compared against a known-clean list of EFI executable binaries to detect potentially malicious modules. The CHIPSEC framework can be used for analysis to determine if firmware modifications have been performed.","url":"https://attack.mitre.org/detectionstrategies/DET0790#AN1922","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0108","component":"Device Alarm","name":"Operational Databases","channel":"None","platforms":["None"],"analytic_id"
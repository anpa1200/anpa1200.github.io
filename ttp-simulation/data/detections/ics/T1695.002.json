{"key":"ics/T1695.002","id":"T1695.002","name":"Ethernet","domain":"ics","platforms":[],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T1695/002","technique_page":"techniques/ics/T1695.002/","page":"detections/ics/T1695.002/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0911","name":"Detection of Block Ethernet","url":"https://attack.mitre.org/detectionstrategies/DET0911","stix_id":"x-mitre-detection-strategy--feb80c7a-96cd-4300-b344-4d75b176c9cb","relationship_id":"relationship--e56064d9-388d-45b3-99a9-4eeec2e681da","description":"","analytics":[{"id":"AN2054","name":"Analytic 2054","guidance":"Monitor asset alarms which may help identify a loss of communications. Consider correlating alarms with other data sources that indicate traffic has been blocked, such as network traffic. In cases where alternative methods of communicating with outstations exist, alarms may still be visible even if Ethernet messages are blocked.\n\nMonitor for a loss of network communications, which may indicate this technique is being used.\n\nMonitor for lack of operational process data which may help identify a loss of communications. This will not directly detect the technique’s execution but instead may provide additional evidence that the technique has been used and may complement other detections.\n\nMonitor application logs for changes to settings and other events associated with network protocols that may be used to block communications.\n\nMonitor for the termination of processes or services associated with ICS automation protocols and application software which could help detect blocked communications.","url":"https://attack.mitre.org/detectionstrategies/DET0911#AN2054","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0109","component":"Process/Event Alarm","
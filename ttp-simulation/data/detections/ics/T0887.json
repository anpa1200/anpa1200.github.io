{"key":"ics/T0887","id":"T0887","name":"Wireless Sniffing","domain":"ics","platforms":["None"],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T0887","technique_page":"techniques/ics/T0887/","page":"detections/ics/T0887/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0743","name":"Detection of Wireless Sniffing","url":"https://attack.mitre.org/detectionstrategies/DET0743","stix_id":"x-mitre-detection-strategy--bbb288c7-9e40-46bd-b0a1-db4cfef4e1ee","relationship_id":"relationship--47b1bc70-9fe4-4a6f-a137-f51db24566da","description":"","analytics":[{"id":"AN1876","name":"Analytic 1876","guidance":"Purely passive network sniffing cannot be detected effectively. In cases where the adversary interacts with the wireless network (e.g., joining a Wi-Fi network) detection may be possible. Monitor for new or irregular network traffic flows which may indicate potentially unwanted devices or sessions on wireless networks.  In Wi-Fi networks monitor for changes such as rogue access points or low signal strength, indicating a device is further away from the access point then expected and changes in the physical layer signal.   Network traffic content will provide important context, such as hardware (e.g., MAC) addresses, user accounts, and types of messages sent.","url":"https://attack.mitre.org/detectionstrategies/DET0743#AN1876","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0078","component":"Network Traffic Flow","name":"Network Traffic","channel":"None","platforms":["None"],"analytic_id":"AN1876","source_url":"https://attack.mitre.org/detectionstrategies/DET0743#AN1876","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]}]}],"telemetry_references":[{"id":"DC0078","name":"Network Traffic Flow","tag":"Network Tr
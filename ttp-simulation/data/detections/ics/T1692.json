{"key":"ics/T1692","id":"T1692","name":"Unauthorized Message","domain":"ics","platforms":[],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T1692","technique_page":"techniques/ics/T1692/","page":"detections/ics/T1692/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0902","name":"Detection of Unauthorized Message","url":"https://attack.mitre.org/detectionstrategies/DET0902","stix_id":"x-mitre-detection-strategy--f487a605-0acb-4b12-b157-33b75ebd9a40","relationship_id":"relationship--71f61677-4406-4484-bacb-c8de82c7e1bd","description":"","analytics":[{"id":"AN2045","name":"Analytic 2045","guidance":"Unauthorized messages may be detected by reviewing the content of automation protocols, either through detecting based on expected values or comparing to other out of band process data sources. Unauthorized messages may not precisely match legitimate messages which may lead to malformed traffic, although traffic may be malformed for benign reasons. Monitor messages for changes in how they are constructed.\n\nMonitor for anomalous or unexpected messages that may result in changes to the process operation observable via asset application logs (e.g., discrete write, logic and device configuration, mode changes, safety triggers).\n\nConsider monitoring for Rogue Master and Adversary-in-the-Middle activity which may precede this technique.","url":"https://attack.mitre.org/detectionstrategies/DET0902#AN2045","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0078","component":"Network Traffic Flow","name":"Network Traffic","channel":"None","platforms":["None"],"analytic_id":"AN2045","source_url":"https://attack.mitre.org/detectionstrategies/DET0902#AN2045","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"},{"component_i
{"key":"ics/T0846","id":"T0846","name":"Remote System Discovery","domain":"ics","platforms":["None"],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T0846","technique_page":"techniques/ics/T0846/","page":"detections/ics/T0846/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0739","name":"Detection of Remote System Discovery","url":"https://attack.mitre.org/detectionstrategies/DET0739","stix_id":"x-mitre-detection-strategy--ec442b22-3dc8-4b2b-8294-b76b0f01d748","relationship_id":"relationship--1531a280-e280-465c-826d-ce357935a89c","description":"","analytics":[{"id":"AN1872","name":"Analytic 1872","guidance":"Monitor for files (such as /etc/hosts) being accessed that may attempt to get a listing of other systems by IP address, hostname, or other logical identifier on a network that may be used for Lateral Movement from the current system.\nMonitor for newly executed processes that can be used to discover remote systems, such as ping.exe and tracert.exe  , especially when executed in quick succession. Consider monitoring for new processes engaging in scanning activity or connecting to multiple systems by correlating process creation network data.\nMonitor for anomalies related to discovery related ICS functions, including devices that have not previously used these functions or for functions being sent to many outstations. Note that some ICS protocols use broadcast or multicast functionality, which may produce false positives. Also monitor for hosts enumerating network connected resources using non-ICS enterprise protocols.\nMonitor for new ICS protocol connections to existing assets or for device scanning (i.e., a host connecting to many devices) over ICS and enterprise protocols (e.g., ICMP, DCOM, WinRM). For added context on adversary enterprise procedures and background see Remote System Discovery.","url":"https://attack.mitre.org/detectionstrategies/DET0739#AN1872","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0055","component":"File Access","name":"File","channel":"None","platforms":["None"],"analytic_id":"AN1872","source_url":"https://attack.mitre.org/detectionstrategies/DET0739#AN1872","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0032","component":"Process Creation","name":"Process","channel":"None","platforms":["None"],"analytic_id":"AN1872","source_url":"https://attack.mitre.org/detectionstrategies/DET0739#AN1872","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"Network Traffic","channel":"None","platforms":["None"],"analytic_id":"AN1872","source_url":"https://attack.mitre.org/detectionstrategies/DET0739#AN1872","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"Network Traffic","channel":"None","platforms":["None"],"analytic_id":"AN1872","source_url":"https://attack.mitre.org/detectionstrategies/DET0739#AN1872","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]}]}],"telemetry_references":[{"id":"DC0055","name":"File Access","tag":"File Access","page":"telemetry/DC0055/","kind":"attack_component"},{"id":"DC0085","name":"Network Traffic Content","tag":"Network Traffic Content","page":"telemetry/DC0085/","kind":"attack_component"},{"id":"DC0078","name":"Network Traffic Flow","tag":"Network Traffic Flow","page":"telemetry/DC0078/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[],"related_parent"
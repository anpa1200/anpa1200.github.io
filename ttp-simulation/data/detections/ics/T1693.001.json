{"key":"ics/T1693.001","id":"T1693.001","name":"System Firmware","domain":"ics","platforms":[],"environments":["ics-ot"],"source_url":"https://attack.mitre.org/techniques/T1693/001","technique_page":"techniques/ics/T1693.001/","page":"detections/ics/T1693.001/","status":"guidance_only","counts":{"sigma":0,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0731","name":"Detection of System Firmware","url":"https://attack.mitre.org/detectionstrategies/DET0731","stix_id":"x-mitre-detection-strategy--09f46edf-33f9-4c23-af2f-74864c27f616","relationship_id":"relationship--c9efe378-d028-4c09-83c7-491fadc3a1f9","description":"","analytics":[{"id":"AN1864","name":"Analytic 1864","guidance":"Monitor for firmware changes which may be observable via operational alarms from devices.\nMonitor device application logs for firmware changes, although not all devices will produce such logs.\nMonitor firmware for unexpected changes. Asset management systems should be consulted to understand known-good firmware versions. Dump and inspect BIOS images on vulnerable systems and compare against known good images. Analyze differences to determine if malicious changes have occurred. Log attempts to read/write to BIOS and compare against known patching behavior. Likewise, EFI modules can be collected and compared against a known-clean list of EFI executable binaries to detect potentially malicious modules. The CHIPSEC framework can be used for analysis to determine if firmware modifications have been performed.\nMonitor ICS management protocols / file transfer protocols for protocol functions related to firmware changes.","url":"https://attack.mitre.org/detectionstrategies/DET0731#AN1864","platforms":["None"],"tuning":[],"log_sources":[{"component_id":"DC0108","component":"Device Alarm","name":"Operational Databases","channel":"None","platforms":["None"],"analytic_id"
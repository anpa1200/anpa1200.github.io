ot_executable_or_live_validated","logic":"COUNT(file_write_or_rename BY process, 5m) >= threshold AND DISTINCT_COUNT(file_extension BY process, 5m) >= threshold -> ALERTMATCH(known_ransomware_signature) -> ALERT","log_sources":[{"title":"File-System Activity Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#13-file-system-activity-logs"},{"title":"Endpoint Detection and Response Telemetry","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#1-endpoint-detection-and-response-telemetry"},{"title":"Antivirus and Antimalware Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#135-antivirus-and-antimalware-logs"}]}],"atlas_anomaly":[{"id":"atlas-anomaly-t1486-1","technique_id":"T1486","title":"Files encrypted for impact — T1486 Data Encrypted for Impact","kind":"anomaly","source_url":"https://1200km.com/anomaly-detection-atlas/attack-statistical-anomaly-mapping/#ransomware-encryption","source_path":"docs/attack-statistical-anomaly-mapping.md","source_line":119,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-statistical-anomaly-mapping.md#L119","source_file_sha256":"9d38eaa6306863918e8193f267fb063270260e50b013928dc97893d5e74bf144","source_row_sha256":"8a0bcb64c041b5ed633c4b78c0ac546469ba55f0e31ba94b4c64c9a8aa3e3e8f","validation":"published_concept_not_executable_or_live_validated","comparison_unit":"process file-operation stream and file population.","expected_behavior":"ordinary processes modify limited file sets with stable extension distributions.","deviation":"sudden high-volume writes, extension-distribution shift, and cascading impact across directories.","anomaly_types":[{"title":"Volume Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#15-volume-anomaly"},{"title":"Categorical-Distribution Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#87-categorical-distribution-anomaly"},{"title":"Cascading Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#114-cascading-anomaly"}],"log_sources":[{"title":"File-System Activity Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#13-file-system-activity-logs"},{"title":"Endpoint Detection and Response Telemetry","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#1-endpoint-detection-and-response-telemetry"}],"context_references":[{"title":"Play ransomware joint advisory — downloaded copy","url":"https://1200km.com/anomaly-detection-atlas/reports/cti-ir/ic3-aa23-352a-play-ransomware.pdf"},{"title":"original source","url":"https://www.ic3.gov/CSA/2023/231218.pdf"}]}],"anomaly_types":[{"title":"Cascading Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#114-cascading-anomaly"},{"title":"Categorical-Distribution Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#87-categorical-distribution-anomaly"},{"title":"Volume Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#15-volume-anomaly"}],"strategies":[{"id":"DET0215","name":"Detection of Multi-Platform File Encryption for Impact","url":"https://attack.mitre.org/detectionstrategies/DET0215","stix_id":"x-mitre-detection-strategy--d080a1b1-5ad1-45a1-8f7b-b736986c20d9","relationship_id":"relationship--245046a7-adc8-4a5a-84b4-e0af6c3b8dc7","description":"","analytics":[{"id":"AN0602","name":"Analytic 0602","guidance":"High-frequency file write operations using uncommon extensions, followed by ransom note creation, registry tampering, or shadow copy deletion. Often uses CLI tools like vssadmin, wbadmin, cipher, or PowerShell.","url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0602","platforms":["Windows"],"tuning":[{"field":"FileExtension","description":"Non-standard or randomly generated file extensions may indicate encrypted content."},{"field":"TargetFolder","description":"Focus on user document folders, network shares, or system paths like %System32%."},{"field":"TimeWindow","description":"Correlate rapid writes and renames within seconds across high file count."},{"field":"CommandLine","description":"Flag common ransomware tools or functions (vssadmin delete shadows /all /quiet)."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0602","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0602","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0602","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0602","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0061","component":"File Modification","name":"WinEventLog:Sysmon","channel":"EventCode=2","platforms":["Windows"],"analytic_id":"AN0602","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0602","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]},{"id":"AN0603","name":"Analytic 0603","guidance":"Encryption via custom or open-source tools (e.g., openssl, gpg, aescrypt) recursively targeting user or system directories. Also includes overwrite of existing data and ransom note drops.","url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0603","platforms":["Linux"],"tuning":[{"field":"FilenamePattern","description":"Look for creation of ransom note files (e.g., READ_ME.txt, HELP_DECRYPT.html)."},{"field":"SyscallBurstRate","description":"High write/open/unlink activity in short intervals indicates encryption attempts."},{"field":"DirectoryTargeted","description":"Correlate activity in /home, /etc, /opt, or mounted volumes."}],"log_sources":[{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"openat, write, rename, unlink","platforms":["Linux"],"analytic_id":"AN0603","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0603","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN0603","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0603","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0604","name":"Analytic 0604","guidance":"Userland or kernel-level ransomware encrypting user files (Documents, Desktop) using `srm`, `gpg`, or compiled payloads. Often correlated with ransom note creation in multiple directories.","url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0604","platforms":["macOS"],"tuning":[{"field":"ExtensionPattern","description":"Encrypted files may use .locked, .enc, or ransom-specific extensions."},{"field":"VolumeTargeted","description":"Detect activity targeting mounted external or backup volumes."}],"log_sources":[{"component_id":"DC0061","component":"File Modification","name":"macos:unifiedlog","channel":"file encrypted|new file with .encrypted extension|disk write burst","platforms":["macOS"],"analytic_id":"AN0604","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"exec srm|exec openssl|exec gpg","platforms":["macOS"],"analytic_id":"AN0604","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0605","name":"Analytic 0605","guidance":"Ransomware encrypts .vmdk, .vmx, .log, or VM config files in VMFS datastores. May rename to .locked or delete/overwrite with encrypted versions. Often correlates with shell commands run through `dcui`, SSH, or vSphere.","url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0605","platforms":["ESXi"],"tuning":[{"field":"FileType","description":"Detect renames or write patterns involving .vmdk, .vmx, .nvram."},{"field":"UserContext","description":"Identify shell sessions opened by root or unexpected users outside maintenance window."}],"log_sources":[{"component_id":"DC0061","component":"File Modification","name":"esxi:vmkernel","channel":"rename .vmdk to .*.locked|datastore write spike","platforms":["ESXi"],"analytic_id":"AN0605","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0064","component":"Command Execution","name":"esxi:shell","channel":"openssl|tar|dd","platforms":["ESXi"],"analytic_id":"AN0605","source_url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"}]},{"id":"AN0606","name":"Analytic 0606","guidance":"Encryption of cloud storage objects (e.g., S3 buckets) via Server-Side Encryption (SSE-C) or by replacing objects with encrypted variants. May include API patterns like PutObject with SSE-C headers.","url":"https://attack.mitre.org/detectionstrategies/DET0215#AN0606","platforms":["IaaS"],"tuning":[{"field":"SSEHeader","description":"SSE-C headers indicate attacker-controlled encryption keys."},{"field":"AffectedBucket","description":"Prioritize logs, backups, or shared document storage buckets."},{"field":"UserAgent","description":"Detect scripted automation vs console-based API 
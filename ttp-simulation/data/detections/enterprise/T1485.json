technique_id":"T1485","title":"T1485 Data Destruction","kind":"basic","source_url":"https://1200km.com/anomaly-detection-atlas/attack-basic-detection-rule-catalog/#impact","source_path":"docs/attack-basic-detection-rule-catalog.md","source_line":188,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-basic-detection-rule-catalog.md#L188","source_file_sha256":"396a87e3d8da74d170684c0f377fe5dc11cd1a486d4f2f89f7fbe94deaaa2a1e","source_row_sha256":"88de1bcb51ce6b7cfb12c3c16188e1ef8ee81a5c06a3c016898387019925a171","validation":"published_concept_not_executable_or_live_validated","logic":"COUNT(delete_operation BY actor_or_process, 5m) >= threshold OR MATCH(delete_on_protected_resource) -> ALERT","log_sources":[{"title":"File-System Activity Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#13-file-system-activity-logs"},{"title":"Database Audit Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#86-database-audit-logs"},{"title":"Cloud Object-Storage Access Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#108-cloud-object-storage-access-logs"}]}],"atlas_anomaly":[{"id":"atlas-anomaly-t1485-1","technique_id":"T1485","title":"Files, records, or resources deleted or destroyed — T1485 Data Destruction","kind":"anomaly","source_url":"https://1200km.com/anomaly-detection-atlas/attack-statistical-anomaly-mapping/#data-destruction","source_path":"docs/attack-statistical-anomaly-mapping.md","source_line":118,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-statistical-anomaly-mapping.md#L118","source_file_sha256":"9d38eaa6306863918e8193f267fb063270260e50b013928dc97893d5e74bf144","source_row_sha256":"d1253bf0794550adfa841abf08430f347599566e53df6c6ec75a2b9c4539e12f","validation":"published_concept_not_executable_or_live_validated","comparison_unit":"actor or process deletion stream.","expected_behavior":"deletions occur at bounded rates and within known workflows.","deviation":"extreme deletion volume, burst, or abrupt transition from read/write to deletion.","anomaly_types":[{"title":"Volume Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#15-volume-anomaly"},{"title":"Burst Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#16-burst-anomaly"},{"title":"Transition Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#61-transition-anomaly"}],"log_sources":[{"title":"File-System Activity Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#13-file-system-activity-logs"},{"title":"Database Audit Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#86-database-audit-logs"},{"title":"Cloud Object-Storage Access Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#108-cloud-object-storage-access-logs"}],"context_references":[{"title":"LockBit joint advisory — downloaded copy","url":"https://1200km.com/anomaly-detection-atlas/reports/cti-ir/ic3-aa23-165a-lockbit.pdf"},{"title":"original source","url":"https://www.ic3.gov/CSA/2023/230614.pdf"}]}],"anomaly_types":[{"title":"Burst Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#16-burst-anomaly"},{"title":"Transition Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#61-transition-anomaly"},{"title":"Volume Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#15-volume-anomaly"}],"strategies":[{"id":"DET0146","name":"Detection of Data Destruction Across Platforms via Mass Overwrite and Deletion Patterns","url":"https://attack.mitre.org/detectionstrategies/DET0146","stix_id":"x-mitre-detection-strategy--c54fdf95-c7ac-4ca4-bd99-273e56da20a5","relationship_id":"relationship--31ece083-4856-4057-bfca-5dd17221b34b","description":"","analytics":[{"id":"AN0411","name":"Analytic 0411","guidance":"Adversary spawns command-line tools (e.g., del, cipher /w, SDelete) or scripts to recursively delete or overwrite user/system files. This may be correlated with abnormal file IO activity, registry writes, or tampering in critical system directories.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","platforms":["Windows"],"tuning":[{"field":"TargetFilename","description":"Filter file deletion activity to sensitive locations (e.g., %System32%, Documents, DB paths)."},{"field":"ProcessCommandLine","description":"Tune for aggressive overwrite flags (e.g., /w, /q, /s) or temp file overwrites."},{"field":"VolumeThreshold","description":"Threshold of unique file deletions or modifications within time window."},{"field":"TimeWindow","description":"Correlate rapid file delete/overwrite behavior from same process/user."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0040","component":"File Deletion","name":"WinEventLog:Sysmon","channel":"EventCode=23","platforms":["Windows"],"analytic_id":"AN0411","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0411","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"}]},{"id":"AN0412","name":"Analytic 0412","guidance":"Massive recursive deletions or overwrites via `rm -rf`, `shred`, `dd`, or wiper binaries. May include unlink syscalls, deletion of known config/data paths, or sequential overwrite patterns.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0412","platforms":["Linux"],"tuning":[{"field":"ExecutablePath","description":"Focus on binaries like shred, dd, wipe, custom wipers, or bash execution chains."},{"field":"DeletedPathPattern","description":"Tune for critical mount points or home/data directories."},{"field":"SyscallBurstRate","description":"Rate of unlink/unlinkat syscalls to indicate mass deletion in a short period."}],"log_sources":[{"component_id":"DC0040","component":"File Deletion","name":"auditd:SYSCALL","channel":"unlink, unlinkat, openat, write","platforms":["Linux"],"analytic_id":"AN0412","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0412","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN0412","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0412","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0413","name":"Analytic 0413","guidance":"Destruction via `rm -rf`, overwrite with `dd` or `srm`, often executed by script in /tmp or /private/tmp, may also involve file overwrite to political or decoy image data.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0413","platforms":["macOS"],"tuning":[{"field":"CommandPattern","description":"Focus on high-risk patterns in temporary directories or key system paths."},{"field":"EntropyChangeRate","description":"Optional anomaly detection on overwritten files with high-entropy payloads."}],"log_sources":[{"component_id":"DC0040","component":"File Deletion","name":"macos:unifiedlog","channel":"exec rm -rf|dd if=/dev|srm|file unlink","platforms":["macOS"],"analytic_id":"AN0413","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0413","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"},{"component_id":"DC0033","component":"Process Termination","name":"macos:unifiedlog","channel":"process.*exit.*code","platforms":["macOS"],"analytic_id":"AN0413","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0413","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0033/"}]},{"id":"AN0414","name":"Analytic 0414","guidance":"Adversary deletes critical infrastructure: EC2 instances, S3 buckets, snapshots, or volumes using elevated IAM credentials. Frequently includes batch API calls with `Delete*` or `TerminateInstances`.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0414","platforms":["IaaS"],"tuning":[{"field":"OperationType","description":"Correlate multiple destructive API calls over short intervals."},{"field":"UserAgent","description":"Flag non-console/API clients initiating destructive behavior."},{"field":"RegionScope","description":"Observe whether deletions span multiple regions or org accounts."}],"log_sources":[{"component_id":"DC0022","component":"Cloud Storage Deletion","name":"AWS:CloudTrail","channel":"DeleteBucket, DeleteDBCluster, DeleteSnapshot, TerminateInstances","platforms":["IaaS"],"analytic_id":"AN0414","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0414","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0022/"}]},{"id":"AN0415","name":"Analytic 0415","guidance":"Adversary destroys virtual disks (VMDK), images, or VMs by invoking `vim-cmd`, deleting datastore contents, or purging snapshots.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0415","platforms":["ESXi"],"tuning":[{"field":"DatastorePath","description":"Targeted deletion of critical VMDKs or VM configuration files."},{"field":"InitiatingUser","description":"Detect deletions from users outside normal maintenance windows."}],"log_sources":[{"component_id":"DC0098","component":"Volume Deletion","name":"esxi:vmkernel","channel":"file delete|datastore purge","platforms":["ESXi"],"analytic_id":"AN0415","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0415","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0098/"}]},{"id":"AN0416","name":"Analytic 0416","guidance":"Container process executes destructive file operations inside volume mounts or host paths. Includes `rm -rf /mnt/volumes/`, container breakout followed by host deletion attempts.","url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0416","platforms":["Containers"],"tuning":[{"field":"MountPoint","description":"Identify when deletions occur inside persistent or shared volume paths."},{"field":"ContainerImage","description":"Correlate destructive behavior with unknown or untrusted container sources."}],"log_sources":[{"component_id":"DC0040","component":"File Deletion","name":"auditd:SYSCALL","channel":"unlink, unlinkat, rmdir","platforms":["Containers"],"analytic_id":"AN0416","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0416","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"},{"component_id":"DC0064","component":"Command Execution","name":"docker:events","channel":"container exec rm|container stop --force","platforms":["Containers"],"analytic_id":"AN0416","source_url":"https://attack.mitre.org/detectionstrategies/DET0146#AN0416","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"}]}]}],"telemetry_references":[{"id":"DC0022","name":"Cloud Storage Deletion","tag":"Cloud Storage Deletion","page":"telemetry/DC0022/","kind":"attack_component"},{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0040","name":"File Deletion","tag":"File Deletion","page":"telemetry/DC0040/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"},{"id":"DC0033","name":"Process Termination","tag":"Process Termination","page":"telemetry/DC0033/","kind":"attack_component"},{"id":"DC0098","name":"Volume Deletion","tag":"Volume Deletion","page":"telemetry/DC0098/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[{"id":"S0364","name":"RawDisk","page":"tools/S0364/","bases":["attack_uses"]},{"id":"S0195","name":"SDelete","page":"tools/S0195/","bases":["attack_uses"]}],"related_parent":null,"article_url":"https://1200km.com/articles/read/2026/2026-04-20-malicious-activity-as-a-statistical-signal-a-detection-engineering-analysis-of-anomaly-bas-90df8b6dea12/","validation":{"source_join":"exact_ids","sigma_yaml":"parsed","backend_compilation":"not_run","live_telemetry":"not_run","detection_execution":"not_run"}}

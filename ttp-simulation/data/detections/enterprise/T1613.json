{"key":"enterprise/T1613","id":"T1613","name":"Container and Resource Discovery","domain":"enterprise","platforms":["Containers"],"environments":["containers"],"source_url":"https://attack.mitre.org/techniques/T1613","technique_page":"techniques/enterprise/T1613/","page":"detections/enterprise/T1613/","status":"rule_source_available","counts":{"sigma":1,"atlas_basic":1,"atlas_anomaly":0,"strategies":1,"analytics":1,"live_validated":0},"sigma_rules":[{"id":"597a7e84-187d-458b-9e4f-2f5a0e676711","title":"Kubernetes Potential Enumeration Activity","status":"experimental","level":"medium","logsource":{"product":"kubernetes","service":"audit"},"data_path":"data/detection-rules/597a7e84-187d-458b-9e4f-2f5a0e676711.json","source_url":"https://github.com/anpa1200/sigma/blob/b249e9683190cffdcaf188ccbfb90bf4759844e1/rules/application/kubernetes/audit/kubernetes_audit_potential_enumeration_activity.yml","author":"uniqu3-us3r","kind":"sigma"}],"atlas_basic":[{"id":"atlas-basic-t1613-1","technique_id":"T1613","title":"T1613 Container and Resource Discovery","kind":"basic","source_url":"https://1200km.com/anomaly-detection-atlas/attack-basic-detection-rule-catalog/#discovery","source_path":"docs/attack-basic-detection-rule-catalog.md","source_line":135,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-basic-detection-rule-catalog.md#L135","source_file_sha256":"396a87e3d8da74d170684c0f377fe5dc11cd1a486d4f2f89f7fbe94deaaa2a1e","source_row_sha256":"631c1066cefece0dd47783c04d71b958bcac461253356d8cf6d0ce6b36b1ba85","validation":"published_concept_not_executable_or_live_validated","logic":"COUNT(orchestrator_list_or_get_requests BY identity, 5m) >= threshold AND identity NOT_IN approved_cluster_admins -> ALERT","log_sources":[{"title":"Orchestrator Audit Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#121-orchestrator-audit-logs"},{"title":"Orchestrator Control-Plane C
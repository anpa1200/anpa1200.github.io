estamps"},{"field":"UserContext","description":"Detects execution under non-interactive/system accounts"}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"macos:unifiedlog","channel":"log stream --predicate","platforms":["macOS"],"analytic_id":"AN1628","source_url":"https://attack.mitre.org/detectionstrategies/DET0591#AN1628","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0059","component":"File Metadata","name":"macos:osquery","channel":"file_events","platforms":["macOS"],"analytic_id":"AN1628","source_url":"https://attack.mitre.org/detectionstrategies/DET0591#AN1628","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0059/"}]},{"id":"AN1629","name":"Analytic 1629","guidance":"Detects abuse of busybox commands (e.g., `touch`) or log timestamp tampering during backdoor persistence or evasion.","url":"https://attack.mitre.org/detectionstrategies/DET0591#AN1629","platforms":["ESXi"],"tuning":[{"field":"TimestampAgeComparison","description":"Unusual backdating to match legit files"},{"field":"PersistenceOverlap","description":"Overlap with known persistence paths"}],"log_sources":[{"component_id":"DC0061","component":"File Modification","name":"esxi:vmkernel","channel":"/var/log/vmkernel.log","platforms":["ESXi"],"analytic_id":"AN1629","source_url":"https://attack.mitre.org/detectionstrategies/DET0591#AN1629","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]}]}],"telemetry_references":[{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0055","name":"File Access","tag":"File Access","page":"telemetry/DC0055/","kind":"attack_component"},{"id":"DC0059","name":"File Metadata","tag":"File Metadata","page":"telemetry/DC0059/","kind":"attack_component"},{"id":"DC0061","name":"File Modification","tag":"File Modification"
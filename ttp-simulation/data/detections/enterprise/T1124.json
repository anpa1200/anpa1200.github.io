dows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0016/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0064","component":"Command Execution","name":"WinEventLog:PowerShell","channel":"EventCode=4103, 4104, 4105, 4106","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0021","component":"OS API Execution","name":"etw:Microsoft-Windows-Kernel-Process","channel":"High-frequency or suspicious sequence of QueryPerformanceCounter/GetTickCount API calls from a non-standard process lineage","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0021/"},{"component_id":"DC0001","component":"Scheduled Job Creation","name":"WinEventLog:TaskScheduler","channel":"EventCode=106","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0001/"},{"component_id":"DC0005","component":"Scheduled Job Metadata","name":"WinEventLog:TaskScheduler","channel":"Task registration/execution shortly after a time discovery event","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0005/"},{"component_id":"DC0034","component":"Process Metadata","name":"EDR:Telemetry","channel":"Process lineage and API usage enrichment (GetSystemTime, GetTimeZoneInformation, NtQuerySystemTime)","platforms":["Windows"],"analytic_id":"AN0430","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0430","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0034/"}]},{"id":"AN0431","name":"Analytic 0431","guidance":"A process (often spawned by a shell, interpreter, or malware implant) executes time discovery via commands (date, timedatectl, hwclock, cat /etc/timezone, /proc/uptime) or direct syscalls (time(), clock_gettime) and is (optionally) followed by scheduled task creation/modification (crontab, at) or conditional sleep logic.","url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0431","platforms":["Linux"],"tuning":[{"field":"AuditRulesSyscalls","description":"Scope of syscalls (time, clock_gettime, gettimeofday) monitored; may be performance-sensitive."},{"field":"AllowedBinaries","description":"List of legitimate automation/orchestration tools frequently querying time."},{"field":"TimeWindow","description":"Correlation window (e.g., 5–20 minutes) to link time discovery to follow-on cron/at changes."},{"field":"UserContextScope","description":"Ignore root-owned maintenance agents if desired; focus on interactive or newly created users."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"type=EXECVE or SYSCALL for /bin/date, /usr/bin/timedatectl, /sbin/hwclock, /bin/cat /etc/timezone, /bin/cat /proc/uptime","platforms":["Linux"],"analytic_id":"AN0431","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0431","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0021","component":"OS API Execution","name":"auditd:SYSCALL","channel":"Rules capturing clock_gettime, time, gettimeofday syscalls when enabled","platforms":["Linux"],"analytic_id":"AN0431","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0431","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0021/"},{"component_id":"DC0002","component":"User Account Authentication","name":"linux:syslog","channel":"sudo/date/timedatectl execution by non-standard users","platforms":["Linux"],"analytic_id":"AN0431","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0431","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0002/"},{"component_id":"DC0005","component":"Scheduled Job Metadata","name":"linux:cron","channel":"cron activity","platforms":["Linux"],"analytic_id":"AN0431","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0431","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0005/"}]},{"id":"AN0432","name":"Analytic 0432","guidance":"Process/script execution of systemsetup -gettimezone, date, ioreg, or API usage (timeIntervalSinceNow, gettimeofday) followed by time-based scheduling (launchd plist modification) or sleep-based execution.","url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0432","platforms":["macOS"],"tuning":[{"field":"LaunchdPaths","description":"Organization-specific list of allowed launchd write locations to filter benign agents."},{"field":"TimeWindow","description":"Correlation window to link time discovery to launchd persistence/scheduling."},{"field":"AllowedCallers","description":"Known management agents (e.g., JAMF) that legitimately call systemsetup/date."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"process exec events of systemsetup, date, ioreg with command_line parameters indicating time discovery","platforms":["macOS"],"analytic_id":"AN0432","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0432","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0005","component":"Scheduled Job Metadata","name":"macos:unifiedlog","channel":"New/modified launchd plist (persistence/scheduling) within TimeWindow after time query","platforms":["macOS"],"analytic_id":"AN0432","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0432","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0005/"}]},{"id":"AN0433","name":"Analytic 0433","guidance":"Interactive or remote shell/API invocation of esxcli system clock get or querying time parameters via hostd/vpxa shortly followed by time/ntp configuration checks or scheduled task creation, executed by non-standard accounts or outside maintenance windows.","url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0433","platforms":["ESXi"],"tuning":[{"field":"MaintenanceWindow","description":"Only alert if outside approved ops windows."},{"field":"PrivilegedAccountsAllowList","description":"Suppress alerts for known service accounts."},{"field":"RemoteIPAllowList","description":"Whitelist management station IPs."},{"field":"TimeWindow","description":"Correlation between esxcli time query and subsequent hostd/vpxa config calls."}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"esxi:shell","channel":"/var/log/shell.log entries containing \"esxcli system clock get\"","platforms":["ESXi"],"analytic_id":"AN0433","source_url":"https://attack.mitre.org/detectionstrategies/DET0151#AN0433","validation":"upstream_definition_not_local
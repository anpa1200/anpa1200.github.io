d:SYSCALL","channel":"useradd or adduser executed","platforms":["Linux"],"analytic_id":"AN1236","source_url":"https://attack.mitre.org/detectionstrategies/DET0447#AN1236","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"write operation on /etc/passwd or /etc/shadow","platforms":["Linux"],"analytic_id":"AN1236","source_url":"https://attack.mitre.org/detectionstrategies/DET0447#AN1236","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]},{"id":"AN1237","name":"Analytic 1237","guidance":"Account creation using 'dscl -create' or via GUI tools. Detection involves command execution and file changes to the local directory services database.","url":"https://attack.mitre.org/detectionstrategies/DET0447#AN1237","platforms":["macOS"],"tuning":[{"field":"UsernamePattern","description":"Accounts like 'svc*', 'backup*' may blend into legit naming patterns"},{"field":"SessionOrigin","description":"Identify if dscl was run locally, via ARD, or Terminal.app"}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"macos:unifiedlog","channel":"dscl -create","platforms":["macOS"],"analytic_id":"AN1237","source_url":"https://attack.mitre.org/detectionstrategies/DET0447#AN1237","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0061","component":"File Modification","name":"macos:unifiedlog","channel":"modification to /var/db/dslocal/nodes/Default/users/","platforms":["macOS"],"analytic_id":"AN1237","source_url":"https://attack.mitre.org/detectionstrategies/DET0447#AN1237","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]},{"id":"AN1238","name":"Analytic 1238","guidance":"Account created using esxcli commands. Sequence includes esxcli execution and successful modification to ac
-43d4-8695-419dcb5d9330.json","source_url":"https://github.com/anpa1200/sigma/blob/b249e9683190cffdcaf188ccbfb90bf4759844e1/rules/windows/process_creation/proc_creation_win_susp_service_tamper.yml","author":"Nasreddine Bencherchali (Nextron Systems), frack113 , X__Junior (Nextron Systems)","kind":"sigma"}],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0021","name":"Behavioral Detection for Service Stop across Platforms","url":"https://attack.mitre.org/detectionstrategies/DET0021","stix_id":"x-mitre-detection-strategy--ae37afa8-87d5-4091-ac33-010e78eefe97","relationship_id":"relationship--091187a1-a960-4731-829d-de865e7d49a1","description":"","analytics":[{"id":"AN0061","name":"Analytic 0061","guidance":"Adversary disables or stops critical services (e.g., Exchange, SQL, AV, endpoint monitoring) using native utilities or API calls, often preceding destructive actions (T1485, T1486). Behavioral chain: Elevated execution context + stop-service or sc.exe or ChangeServiceConfigW + terminated or disabled service + possible follow-up file manipulation.","url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0061","platforms":["Windows"],"tuning":[{"field":"TimeWindow","description":"Time span between elevated privilege use and critical service stop"},{"field":"ServiceName","description":"Service names of interest (e.g., MSExchangeIS, SQLSERVERAGENT)"},{"field":"ParentProcess","description":"Upstream process lineage leading to service stop"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0061","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0061","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0088","component":"Logon Session Metadata","name":"WinEventLog:Security","channel":"EventCode=4672","platforms":["Windows"],"analytic_id":"AN0061","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0061","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0088/"},{"component_id":"DC0060","component":"Service Creation","name":"WinEventLog:System","channel":"EventCode=7036","platforms":["Windows"],"analytic_id":"AN0061","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0061","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0060/"},{"component_id":"DC0041","component":"Service Metadata","name":"WinEventLog:Sysmon","channel":"EventCode=4","platforms":["Windows"],"analytic_id":"AN0061","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0061","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0041/"}]},{"id":"AN0062","name":"Analytic 0062","guidance":"Adversary executes systemctl or service stop targeting high-value services (e.g., mysql, sshd), possibly followed by rm or shred against data stores. Behavioral chain: sudo/su usage + stop command + /var/log/messages or syslog entries + file access/delete.","url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0062","platforms":["Linux"],"tuning":[{"field":"TimeWindow","description":"Window between service stop and suspicious file deletion"},{"field":"ExecUser","description":"Username or UID executing service stop command"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve of systemctl or service stop","platforms":["Linux"],"analytic_id":"AN0062","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0062","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0040","component":"File Deletion","name":"auditd:SYSCALL","channel":"unlink/unlinkat on service binaries or data targets","platforms":["Linux"],"analytic_id":"AN0062","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0062","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0040/"},{"component_id":"DC0041","component":"Service Metadata","name":"linux:syslog","channel":"service stopped messages","platforms":["Linux"],"analytic_id":"AN0062","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0062","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0041/"}]},{"id":"AN0063","name":"Analytic 0063","guidance":"Use of launchctl to stop services or kill critical background processes (e.g., securityd, com.apple.*), typically followed by command-line tools like rm or diskutil. Behavioral chain: Terminal or remote shell + launchctl bootout/disable + process termination + follow-on modification.","url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0063","platforms":["macOS"],"tuning":[{"field":"ServiceLabel","description":"Launch daemon label or name targeted by command"},{"field":"LaunchType","description":"Whether the command disables or boots out the service"}],"log_sources":[{"component_id":"DC0041","component":"Service Metadata","name":"macos:unifiedlog","channel":"launchctl disable or bootout calls","platforms":["macOS"],"analytic_id":"AN0063","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0063","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0041/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve of launchctl or pkill","platforms":["macOS"],"analytic_id":"AN0063","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0063","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0064","name":"Analytic 0064","guidance":"Attacker disables VM-related services or stops VMs forcibly to target vmdk or logs. Behavioral chain: esxcli or vim-cmd stop + audit log showing user privilege use + datastore file manipulation.","url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0064","platforms":["ESXi"],"tuning":[{"field":"VMName","description":"Targeted virtual machine name"},{"field":"InitiatorUser","description":"User who issued stop or disable command"}],"log_sources":[{"component_id":"DC0041","component":"Service Metadata","name":"esxi:hostd","channel":"Stop VM or disable service events via vim-cmd","platforms":["ESXi"],"analytic_id":"AN0064","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0064","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0041/"},{"component_id":"DC0033","component":"Process Termination","name":"esxi:hostd","channel":"Log entries indicating VM powered off or forcibly terminated","platforms":["ESXi"],"analytic_id":"AN0064","source_url":"https://attack.mitre.org/detectionstrategies/DET0021#AN0064","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0033/"}]}]}],"telemetry_references":[{"id":"DC0040","name":"File Deletion","tag":"File Deletion","page":"telemetry/DC0040/","kind":"attack_component"},{"id":"DC0088","name":"Logon Session Metadata","tag":"Logon Session Metadata","page":"telemetry/DC0088/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"},{"id":"DC0033","name":"Process Termination","tag":"Process Termination","page":"telemetry/DC0033/","kind":"attack_component"},{"id":"DC0060","name":"Service Creation","tag":"Service Creation","page":"telemetry/DC0060/","kind":"attack_component"},{"id":"DC0041","name":"Service Metadata","tag":"Service Metadata","page":"telemetry/DC0041/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[],"related_parent":null,"article_url":"https://1200km.com/articles/read/2026/2026-04-20-malicious-activity-as-a-statistical-signal-a-detection-engineering-analysis-
ithub.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-basic-detection-rule-catalog.md#L45","source_file_sha256":"396a87e3d8da74d170684c0f377fe5dc11cd1a486d4f2f89f7fbe94deaaa2a1e","source_row_sha256":"374721c2e268ff151e5ce88a6a1a793ffda50b807e09c9b28b862a5794e09049","validation":"published_concept_not_executable_or_live_validated","logic":"MATCH(waf_exploit_signature OR ids_exploit_signature OR known_exploit_request_pattern) -> ALERT","log_sources":[{"title":"Web Application Firewall Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#67-web-application-firewall-logs"},{"title":"Network Intrusion Detection Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#61-network-intrusion-detection-logs"},{"title":"Web Server Access Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#79-web-server-access-logs"}]}],"atlas_anomaly":[{"id":"atlas-anomaly-t1190-1","technique_id":"T1190","title":"Public-facing application exploitation — T1190 Exploit Public-Facing Application","kind":"anomaly","source_url":"https://1200km.com/anomaly-detection-atlas/attack-statistical-anomaly-mapping/#public-app-exploitation","source_path":"docs/attack-statistical-anomaly-mapping.md","source_line":34,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-statistical-anomaly-mapping.md#L34","source_file_sha256":"9d38eaa6306863918e8193f267fb063270260e50b013928dc97893d5e74bf144","source_row_sha256":"467fdafebf64343bdafb30d527432037c4ce49a39426b3bae0151ea0b64e587b","validation":"published_concept_not_executable_or_live_validated","comparison_unit":"request and application process.","expected_behavior":"requests produce known response patterns and application behavior.","deviation":"request feature combinations, error distributions, or request-to-child-process transitions outside the normal application flow. Signature detection is often stronger for known exploits.","anomaly_types":[{"title":"Conditional Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#5-conditional-anomaly"},{"title":"Transition Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#61-transition-anomaly"},{"title":"Distribution-Shift Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#34-distribution-shift-anomaly"}],"log_sources":[{"title":"Web Application Firewall Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#67-web-application-firewall-logs"},{"title":"Web Server Access Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#79-web-server-access-logs"},{"title":"Application Runtime Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#82-application-runtime-logs"}],"context_references":[{"title":"Play ransomware joint advisory — downloaded copy","url":"https://1200km.com/anomaly-detection-atlas/reports/cti-ir/ic3-aa23-352a-play-ransomware.pdf"},{"title":"original source","url":"https://www.ic3.gov/CSA/2023/231218.pdf"}]}],"anomaly_types":[{"title":"Conditional Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#5-conditional-anomaly"},{"title":"Distribution-Shift Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#34-distribution-shift-anomaly"},{"title":"Transition Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#61-transition-anomaly"}],"strategies":[{"id":"DET0080","name":"Exploit Public-Facing Application – multi-signal correlation (request → error → post-exploit process/egress)","url":"https://attack.mitre.org/detectionstrategies/DET0080","stix_id":"x-mitre-detection-strategy--dd8477c8-2aad-4db3-b810-fe0d2f605fa8","relationship_id":"relationship--69e8d620-b9a1-4bfd-9bf0-62d2915f08ad","description":"","analytics":[{"id":"AN0219","name":"Analytic 0219","guidance":"Adversary sends crafted HTTP/S (or other service) input to an Internet-facing app (IIS/ASP.NET, API, device portal). Chain: (1) abnormal request patterns to public endpoint → (2) elevated 4xx/5xx or unusual methods/paths → (3) server process (w3wp.exe/other service) spawns shell/LOLbins or loads non-standard modules → (4) optional outbound callback from the host/container.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0219","platforms":["Windows"],"tuning":[{"field":"PublicVIPs","description":"List of public IPs/hostnames that front apps; used to scope web log and Zeek/proxy data."},{"field":"SuspiciousPatterns","description":"Regex set for exploit-like inputs (../, union select, cmd=, ${jndi:, rO0AB (Java serialization), %00, ${env:}, ${${::-j}ndi})."},{"field":"ErrorRateThreshold","description":"Spike threshold for HTTP status 5xx/4xx per client or URI (e.g., >5 in 5m)."},{"field":"TimeWindow","description":"Correlation horizon between request, error, process spawn, and egress (e.g., 15 minutes)."},{"field":"AllowedChildList","description":"Known child processes of app pools (e.g., msbuild.exe in CI) to reduce false positives."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"ApplicationLog:IIS","channel":"IIS W3C logs in C:\\inetpub\\logs\\LogFiles\\W3SVC* (spikes in 5xx, RCE/SQLi/path traversal/JNDI patterns)","platforms":["Windows"],"analytic_id":"AN0219","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0219","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0219","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0219","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0016","component":"Module Load","name":"WinEventLog:Sysmon","channel":"EventCode=7","platforms":["Windows"],"analytic_id":"AN0219","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0219","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0016/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN0219","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0219","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"}]},{"id":"AN0220","name":"Analytic 0220","guidance":"Adversary exploits Apache/Nginx/app servers. Chain: (1) suspicious requests in access logs → (2) spike of 5xx or WAF blocks → (3) web server or interpreter (apache2/nginx/php-fpm/node/python) spawns /bin/sh, curl, wget, socat, or writes webshell → (4) outbound callback.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0220","platforms":["Linux"],"tuning":[{"field":"WebProcList","description":"server/interpreter names to watch (apache2, httpd, nginx, php-fpm, uwsgi, gunicorn, node)."},{"field":"ChildToolList","description":"post-exploitation binaries (sh, bash, curl, wget, python, perl, socat, nc)."},{"field":"BurstThreshold","description":"Rate of errors/requests per src_ip/uri to flag reconnaissance/exploit spray."},{"field":"TimeWindow","description":"Exec/network correlation window."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"ApplicationLog:WebServer","channel":"/var/log/httpd/access_log, /var/log/apache2/access.log, /var/log/nginx/access.log with exploit indicators and burst errors","platforms":["Linux"],"analytic_id":"AN0220","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0220","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN0220","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0220","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Flow","channel":"HTTP payloads with SQLi/LFI/JNDI/deserialization indicators","platforms":["Linux"],"analytic_id":"AN0220","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0220","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN0221","name":"Analytic 0221","guidance":"Adversary targets macOS-hosted public services (e.g., nginx, node). Chain: suspicious inbound request → service crash/5xx → service spawns shell or writes file → new outbound connection.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0221","platforms":["macOS"],"tuning":[{"field":"ServiceList","description":"Names/paths of public daemons on macOS (httpd, nginx, node, java)."},{"field":"TimeWindow","description":"Correlation window for request → exec → egress."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"macos:unifiedlog","channel":"App/web server logs ingested via unified logging or filebeat (nginx/apache/node).","platforms":["macOS"],"analytic_id":"AN0221","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0221","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"exec events where web process starts a shell/tooling","platforms":["macOS"],"analytic_id":"AN0221","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0221","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Flow","channel":"outbound egress from web host after suspicious request","platforms":["macOS"],"analytic_id":"AN0221","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0221","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN0222","name":"Analytic 0222","guidance":"Adversary exploits containerized app via ingress or service. Chain: (1) suspicious request in ingress/app logs → (2) container process spawns a shell/exec/sidecar (kubectl exec/docker exec) → (3) egress to Internet or metadata service (169.254.169.254).","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0222","platforms":["Containers"],"tuning":[{"field":"IngressNamespaces","description":"Namespaces that are Internet-facing."},{"field":"MetadataEndpoints","description":"Cloud metadata IPs/hostnames for exfil of credentials."},{"field":"TimeWindow","description":"Join period between ingress request and pod exec/egress."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"ApplicationLog:Ingress","channel":"Kubernetes NGINX/Envoy ingress controller logs with anomalous payloads and 5xx spikes","platforms":["Containers"],"analytic_id":"AN0222","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0222","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0032","component":"Process Creation","name":"docker:events","channel":"Docker/Kubernetes audit of exec/attach (kubectl exec) or unexpected child processes inside container","platforms":["Containers"],"analytic_id":"AN0222","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0222","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Flow","channel":"Requests towards cloud metadata or command & control from pod IPs","platforms":["Containers"],"analytic_id":"AN0222","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0222","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN0223","name":"Analytic 0223","guidance":"Adversary targets cloud-hosted public endpoints. Chain: (1) ALB/ELB/Cloud LB logs show exploit-like inputs or error spikes → (2) workload spawns shell or reaches metadata API → (3) egress to new external hosts.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0223","platforms":["IaaS"],"tuning":[{"field":"LBProjects","description":"Cloud accounts/subscriptions/regions to include."},{"field":"ErrorBurst","description":"5xx/4xx per client threshold."}],"log_sources":[{"component_id":"DC0085","component":"Network Traffic Content","name":"ALB:HTTPLogs","channel":"AWS ALB/ELB/GCP/Azure Application Gateway HTTP logs with unusual methods, long URIs, serialized payloads, 4xx/5xx bursts","platforms":["IaaS"],"analytic_id":"AN0223","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0223","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"AWS:VPCFlowLogs","channel":"VPC/NSG flow logs for pod/instance egress to Internet or metadata","platforms":["IaaS"],"analytic_id":"AN0223","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0223","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]},{"id":"AN0224","name":"Analytic 0224","guidance":"Adversary exploits exposed OpenSLP on ESXi or vCenter public endpoints. Chain: inbound request pattern to mgmt service → hostd/vpxd error/crash/restart → unexpected process behavior or datastore access → outbound callback.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0224","platforms":["ESXi"],"tuning":[{"field":"MgmtCIDR","description":"Only trusted admin networks should reach ESXi/vCenter."},{"field":"TimeWindow","description":"Join errors and inbound flows."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"esxi:hostd","channel":"/var/log/hostd.log anomalies (faults, crashes, restarts) around inbound connections","platforms":["ESXi"],"analytic_id":"AN0224","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0224","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Flow","channel":"Connections to TCP 427 (SLP) or vCenter web services from untrusted sources","platforms":["ESXi"],"analytic_id":"AN0224","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0224","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN0225","name":"Analytic 0225","guidance":"Adversary exploits public admin services on routers/firewalls/switches. Chain: anomalous HTTP/SNMP/SmartInstall inputs → device syslog errors/restarts → config changes/CLI spawn → egress to attacker C2.","url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0225","platforms":["Network Devices"],"tuning":[{"field":"MgmtPorts","description":"List of admin services to watch (8443, 443, 161/udp, 4786, 22)."},{"field":"TrustedAdmins","description":"Admin source ranges to allow."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"networkdevice:controlplane","channel":"Syslog from edge devices with HTTP 500s on mgmt portal, SmartInstall events, unexpected CLI commands","platforms":["Network Devices"],"analytic_id":"AN0225","source_url":"https://attack.mitre.org/detectionstrategies/DET0080#AN0225","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0085","
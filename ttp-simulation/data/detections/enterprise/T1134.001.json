ction for T1134.001 Access Token Manipulation: Token Impersonation/Theft on Windows","url":"https://attack.mitre.org/detectionstrategies/DET0482","stix_id":"x-mitre-detection-strategy--0b06e42c-ab1c-4fb7-834b-10293e904173","relationship_id":"relationship--0ec457d8-ffb0-459f-aac2-571e7b6111e7","description":"","analytics":[{"id":"AN1324","name":"Analytic 1324","guidance":"Detection of token duplication and impersonation attempts by correlating suspicious command-line executions (e.g., runas) with API calls to DuplicateToken, DuplicateTokenEx, ImpersonateLoggedOnUser, or SetThreadToken. The chain includes the initial command execution or in-memory API invocation → token handle duplication or thread token assignment → a new or existing process assuming the impersonated user's context.","url":"https://attack.mitre.org/detectionstrategies/DET0482#AN1324","platforms":["Windows"],"tuning":[{"field":"AllowedSystemProcesses","description":"Whitelist of known processes that legitimately duplicate tokens (e.g., services.exe)."},{"field":"TimeWindow","description":"Time interval between API call and subsequent impersonated process (e.g., 5m)."},{"field":"UserContextFilter","description":"Filter for service accounts or known administrative accounts that perform legitimate impersonation."},{"field":"ParentProcessAnomalyThreshold","description":"Threshold for parent-child process lineage anomalies indicating token theft."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN1324","source_url":"https://attack.mitre.org/detectionstrategies/DET0482#AN1324","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN1324","source_url":"https://attack.mitre.org/detectionstrategies/DET0482#AN1324","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"},{"component_id":"DC0021","component":"OS API Execution","name":"ETW:Token","channel":"api_call: DuplicateTokenEx, ImpersonateLoggedOnUser, SetThreadToken","platforms":["Windows"],"analytic_id":"AN1324","source_url":"https://attack.mitre.org/detectionstrategies/DET0482#AN1324","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0021/"}]}]}],"telemetry_references":[{"id":"DC0021","name":"OS API Execution","tag":"OS API Execution","page":"telemetry/DC0021/","kind":"attack_component"},{"id":"DC0035","name":"Process Access","tag":"Process Access","page":"telemetry/DC0035/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[{"id":"S0154","name":"Cobalt Strike","page":"tools/S0154/","bases":["attack_uses"]},{"id":"S0192","name":"Pupy","page":"tools/S0192/","bases":["attack_uses"]},{"id":"S0692","name":"SILENTTRINITY","page":"tools/S0692/","bases":["attack_uses"]}],"related_parent":{"key":"enterprise/T1134","id":"T1134","name":"Access Token Manipulation","page":"detections/enterprise/T1134/","note":"Related parent research only. Not inherited rule or anomaly coverage for this sub-technique."},"article_url":"https://1200km.com/articles/read/2026/2026-04-20-malicious-activity-as-a-statistical-signal-a-detection-engineering-analysis-of-anomaly-bas-90df8b6dea12/","validation":{"source_join":"exact_ids","sigma_yaml":"parsed","backend_compilation":"not_run","live_telemetry":"not_run","detection_execution":"not_run"}}

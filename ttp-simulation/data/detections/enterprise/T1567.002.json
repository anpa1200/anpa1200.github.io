nd high outbound traffic volume to known storage APIs.","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","platforms":["Windows"],"tuning":[{"field":"CloudStorageDomains","description":"List of monitored domains for cloud services (dropbox.com, drive.google.com, onedrive.live.com)."},{"field":"ExfilVolumeThreshold","description":"Data volume threshold (e.g., >10MB in single session) used to flag abnormal transfers."},{"field":"UserContext","description":"User accounts permitted to use sanctioned cloud services versus unexpected accounts."}],"log_sources":[{"component_id":"DC0055","component":"File Access","name":"WinEventLog:Security","channel":"EventCode=4663, 4670, 4656","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1571","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1571","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN1572","name":"Analytic 1572","guidance":"Processes such as curl, wget, rclone, or custom scripts executing uploads to cloud storage endpoints. Defender perspective: detect chained events where tar/gzip is executed to compress files followed by HTTPS PUT/POST requests to known storage services.","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","platforms":["Linux"],"tuning":[{"field":"AllowedTools","description":"Known tools used legitimately for backups (rclone, gsutil). Deviations raise suspicion."},{"field":"WorkHours","description":"Baseline normal data transfer hours to reduce false positives."}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"auditd:EXECVE","channel":"curl -T, rclone copy","platforms":["Linux"],"analytic_id":"AN1572","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"read/open of sensitive file directories","platforms":["Linux"],"analytic_id":"AN1572","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"NSM:Flow","channel":"large HTTPS outbound uploads","platforms":["Linux"],"analytic_id":"AN1572","source_url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1572","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]},{"id":"AN1573","name":"Analytic 1573","guidance":"Applications or scripts invoking cloud storage APIs (Dropbox sync, iCloud, Google Drive client) in unexpected contexts. Defender perspective: detect sensitive file reads by non-standard applications followed by unusual encrypted uploads to external cloud storage domains.","url":"https://attack.mitre.org/detectionstrategies/DET0570#AN1573","platforms":["macOS"],"tuning":[{"field":"WatchedApps","description":"Track processes that normally should not upload data (e.g., Preview, Calculator)."},{"field":"EntropyThreshold","description":"High-entropy file uploads may indicate encrypted payloads designed for exfiltration."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"maco
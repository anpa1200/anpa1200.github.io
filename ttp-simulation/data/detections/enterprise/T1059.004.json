ce_path":"docs/attack-basic-detection-rule-catalog.md","source_line":57,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-basic-detection-rule-catalog.md#L57","source_file_sha256":"396a87e3d8da74d170684c0f377fe5dc11cd1a486d4f2f89f7fbe94deaaa2a1e","source_row_sha256":"36c1eabd407f8e621261a4c15fa1501404411b5fef8faa52a763cd5b5110664d","validation":"published_concept_not_executable_or_live_validated","logic":"MATCH(shell_execution) AND command_line MATCHES suspicious_command_patterns -> ALERT","log_sources":[{"title":"Linux Audit Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#31-linux-audit-logs"},{"title":"Linux Shell History","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#33-linux-shell-history"},{"title":"Process Execution Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#6-process-execution-logs"}]}],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0384","name":"Behavioral Detection of Unix Shell Execution","url":"https://attack.mitre.org/detectionstrategies/DET0384","stix_id":"x-mitre-detection-strategy--4a89bf52-7be1-405d-8d02-462e52553bc5","relationship_id":"relationship--a9b074ff-ade1-47d6-b74b-ed0b14c0a276","description":"","analytics":[{"id":"AN1081","name":"Analytic 1081","guidance":"Detects bash, sh, zsh, or BusyBox shell execution initiated via remote sessions, unauthorized users, or embedded within secondary script interpreters. Focus is on chained behavior: shell > suspicious commands > network discovery or persistence indicators.","url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1081","platforms":["Linux"],"tuning":[{"field":"ExecutableName","description":"Detect variants like /bin/sh, /usr/local/bin/zsh, /bin/busybox sh."},{"field":"UserContext","description":"Shell used by service accounts, root, or rare accounts."},{"field":"ParentProcess","description":"Shell invoked by unexpected parents (e.g., curl, mail, apache2)."},{"field":"TimeWindow","description":"Execution outside maintenance windows or normal activity periods."},{"field":"CommandLinePattern","description":"Flags use of loops, download commands, chaining (|, &&), or reverse shells."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN1081","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1081","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"linux:osquery","channel":"socket_events","platforms":["Linux"],"analytic_id":"AN1081","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1081","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"},{"component_id":"DC0067","component":"Logon Session Creation","name":"linux:syslog","channel":"auth.log / secure.log","platforms":["Linux"],"analytic_id":"AN1081","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1081","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0067/"}]},{"id":"AN1082","name":"Analytic 1082","guidance":"Identifies use of sh/bash/zsh in suspicious context, such as user scripts launched from non-standard apps (e.g., Preview.app), embedded in LaunchDaemons, or executed outside Terminal.app. Looks for misuse in Automator, LaunchAgents, or NSAppleScript-executed shell.","url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1082","platforms":["macOS"],"tuning":[{"field":"ScriptLocation","description":"Execution from /Users/Shared, ~/Library/LaunchAgents, /tmp."},{"field":"ParentProcess","description":"Shells spawned from Preview, Safari, or AppleScript."},{"field":"UserRole","description":"Detection thresholds may differ for admin vs standard users."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"log stream --predicate 'eventMessage contains \"exec\"'","platforms":["macOS"],"analytic_id":"AN1082","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1082","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0064","component":"Command Execution","name":"macos:osquery","channel":"launchd + process_events","platforms":["macOS"],"analytic_id":"AN1082","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1082","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0029","component":"Script Execution","name":"macos:syslog","channel":"system.log, asl.log","platforms":["macOS"],"analytic_id":"AN1082","source_url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1082","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0029/"}]},{"id":"AN1083","name":"Analytic 1083","guidance":"Detects BusyBox or Ash shell execution from unauthorized logins or remote connections. Focus is on rare shell invocations from DCUI, SSH sessions, or remote management paths. Also watches for payload droppers or persistence artifacts using shell.","url":"https://attack.mitre.org/detectionstrategies/DET0384#AN1083","platforms":["ESXi"],"tuning":[{"field":"UserContext","description":"Non-root use of shell (or root outside maintenance window)."},{"field":"CommandPattern","description":"Use of ‘nc’, ‘wget’, or dropper-like behavior in shell."},{"field":"ShellPath","description":"Unexpected invocation of BusyBox/ash from mounted ISO or datastore."}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"esxi:vmkernel","channel":"DCUI shell start, BusyBox activity","platforms":["ESXi"],"analytic_id":"AN1083","source_url":"https://attack.mitre.org/detectionstrategies/
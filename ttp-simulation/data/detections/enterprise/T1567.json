548#AN1511","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"}]},{"id":"AN1512","name":"Analytic 1512","guidance":"Processes (tar, curl, python scripts) accessing large file sets and initiating outbound HTTPS POST requests with payload sizes inconsistent with baseline activity. Defender perspective: detect abnormal sequence of file archival followed by encrypted uploads to external web services.","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","platforms":["Linux"],"tuning":[{"field":"MonitoredTools","description":"Suspicious command-line utilities used for exfiltration (curl, wget, python)."},{"field":"DataVolumeThreshold","description":"Bytes transferred threshold per session to flag unusual uploads."}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"auditd:EXECVE","channel":"curl or wget with POST/PUT options","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"open/read of sensitive directories (/etc, /home/*)","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"NSM:Flow","channel":"sustained outbound HTTPS sessions with high data volume","platforms":["Linux"],"analytic_id":"AN1512","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1512","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]},{"id":"AN1513","name":"Analytic 1513","guidance":"Office apps or scripts writing files followed by xattr manipulation (to evade quarantine) and subsequent HTTPS uploads. Defender perspective: anomalous file modification + outbound TLS traffic originating from non-networking apps (Word, Excel, Preview).","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","platforms":["macOS"],"tuning":[{"field":"WatchedApplications","description":"Applications not expected to perform bulk data transfers (Office apps, Preview)."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"execution of Office binaries with network activity","platforms":["macOS"],"analytic_id":"AN1513","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0055","component":"File Access","name":"macos:unifiedlog","channel":"read/write of user documents prior to upload","platforms":["macOS"],"analytic_id":"AN1513","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"macos:unifiedlog","channel":"outbound TLS connections to cloud storage providers","platforms":["macOS"],"analytic_id":"AN1513","source_url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1513","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN1514","name":"Analytic 1514","guidance":"Abnormal API calls from user accounts invoking file upload endpoints outside normal baselines (M365, Google Drive, Box). Defender perspective: monitor unified audit logs for elevated frequency of Upload, Create, or Copy operations from compromised accounts.","url":"https://attack.mitre.org/detectionstrategies/DET0548#AN1514","platforms":["SaaS"],"tuning":[{"field":"APICallThreshold","description":"Maximum number of API calls per user/session before triggering alert
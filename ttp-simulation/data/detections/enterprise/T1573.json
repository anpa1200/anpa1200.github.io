,"component_page":"telemetry/DC0016/"}]},{"id":"AN0760","name":"Analytic 0760","guidance":"Processes like curl, wget, python, socat, or custom binaries initiating TLS/SSL sessions to non-standard destinations. Defender sees abnormal syscalls for connect(), loading of libssl libraries, and persistent outbound encrypted traffic from daemons not normally communicating externally.","url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0760","platforms":["Linux"],"tuning":[{"field":"WhitelistedDaemons","description":"Legitimate system services expected to use TLS (e.g., package updates)."},{"field":"CertificateAuthorities","description":"Trusted CAs; flag self-signed or unrecognized certs."}],"log_sources":[{"component_id":"DC0082","component":"Network Connection Creation","name":"auditd:SYSCALL","channel":"socket/connect with TLS context by unexpected process","platforms":["Linux"],"analytic_id":"AN0760","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0760","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"},{"component_id":"DC0038","component":"Application Log Content","name":"linux:syslog","channel":"system daemons initiating TLS sessions outside expected services","platforms":["Linux"],"analytic_id":"AN0760","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0760","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0032","component":"Process Creation","name":"linux:osquery","channel":"Processes linked with libssl or crypto libraries making outbound connections","platforms":["Linux"],"analytic_id":"AN0760","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0760","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0761","name":"Analytic 0761","guidance":"Applications or launchd jobs initiating encrypted TLS traffic to rare external hosts. Defender observes unified logs showing ssl/TLS API calls by processes not baseline-approved, and payload entropy suggesting encrypted C2 sessions.","url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0761","platforms":["macOS"],"tuning":[{"field":"DoHResolvers","description":"Known legitimate DoH endpoints to reduce false positives."},{"field":"PayloadEntropyThreshold","description":"High-entropy traffic deviations used to detect concealed channels."}],"log_sources":[{"component_id":"DC0085","component":"Network Traffic Content","name":"macos:unifiedlog","channel":"Encrypted session initiation by unexpected binary","platforms":["macOS"],"analytic_id":"AN0761","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0761","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"Process invoking SSL routines from Security framework","platforms":["macOS"],"analytic_id":"AN0761","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0761","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN0762","name":"Analytic 0762","guidance":"VMware management daemons or guest processes initiating encrypted connections outside expected vCenter, update servers, or internal comms. Defender identifies hostd or vpxa initiating outbound TLS flows with uncommon destinations.","url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0762","platforms":["ESXi"],"tuning":[{"field":"AllowedMgmtHosts","description":"Baseline approved endpoints for vCenter or update services."}],"log_sources":[{"component_id":"DC0078","component":"Network Traffic Flow","name":"esxi:vpxd","channel":"TLS session established by ESXi service to unapproved endpoint","platforms":["ESXi"],"analytic_id":"AN0762","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0762","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"esxi:vmkernel","channel":"Inspection of sockets showing encrypted sessions from non-baseline processes","platforms":["ESXi"],"analytic_id":"AN0762","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0762","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN0763","name":"Analytic 0763","guidance":"Unusual TLS tunnels through ports not normally encrypted (e.g., TLS on port 8080, 53). Defender sees NetFlow/IPFIX or packet inspection indicating high-entropy traffic volumes and asymmetric client/server exchange ratios.","url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0763","platforms":["Network Devices"],"tuning":[{"field":"PortProfiles","description":"Define expected TLS port usage to flag anomalies."},{"field":"TrafficAsymmetryRatio","description":"Sent/received byte thresholds to catch hidden C2."}],"log_sources":[{"component_id":"DC0078","component":"Network Traffic Flow","name":"NSM:Flow","channel":"Session records with TLS-like byte patterns","platforms":["Network Devices"],"analytic_id":"AN0763","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0763","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Connections","channel":"Abnormal certificate chains or non-standard ports carrying TLS","platforms":["Network Devices"],"analytic_id":"AN0763","source_url":"https://attack.mitre.org/detectionstrategies/DET0273#AN0763","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]}]}],"telemetry_references":[{"id":"DC0038","name":"Application Log Content","tag":"Application Log Content","page":"telemetry/DC0038/","kind":"attack_component"},{"id":"DC0016","name":"Module Load",
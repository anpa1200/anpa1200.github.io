sions to reduce false positives from authorized use."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN0875","source_url":"https://attack.mitre.org/detectionstrategies/DET0314#AN0875","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0060","component":"Service Creation","name":"WinEventLog:System","channel":"EventCode=7045","platforms":["Windows"],"analytic_id":"AN0875","source_url":"https://attack.mitre.org/detectionstrategies/DET0314#AN0875","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0060/"}]},{"id":"AN0876","name":"Analytic 0876","guidance":"Correlates interface mode changes to promiscuous with execution of sniffing tools like tcpdump, tshark, or custom pcap libraries. Detects abnormal NIC configurations and unauthorized sniffing from non-root sessions.","url":"https://attack.mitre.org/detectionstrategies/DET0314#AN0876","platforms":["Linux"],"tuning":[{"field":"InterfaceList","description":"Limit analysis to external interfaces (e.g., eth0, wlan0) and exclude virtual adapters."},{"field":"PromiscuousSessionThreshold","description":"Raise alerts if interface remains in PROMISC longer than threshold duration."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve, setifflags","platforms":["Linux"],"analytic_id":"AN0876","source_url":"https://attack.mitre.org/detectionstrategies/DET0314#AN0876","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0064","component":"Command Execution","name":"auditd:SYSCALL","channel":"promiscuous mode transitions (ioctl or ifconfig)","platforms":["Linux"],"analytic_id":"AN0876","source_url":"https://attack.mitre.org/detectionstrategies/DET0314#AN0876","validation":"upstream_definition_n
AllowList","description":"Roles third-parties may hold (e.g., Helpdesk Admin); flag broader scopes."}],"log_sources":[{"component_id":"DC0067","component":"Logon Session Creation","name":"azure:signinlogs","channel":"InteractiveUser, ServicePrincipalSignIn","platforms":["Identity Provider"],"analytic_id":"AN1347","source_url":"https://attack.mitre.org/detectionstrategies/DET0488#AN1347","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0067/"},{"component_id":"DC0088","component":"Logon Session Metadata","name":"azure:audit","channel":"Add delegated admin / Assign admin roles / Update application consent","platforms":["Identity Provider"],"analytic_id":"AN1347","source_url":"https://attack.mitre.org/detectionstrategies/DET0488#AN1347","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0088/"},{"component_id":"DC0038","component":"Application Log Content","name":"m365:unified","channel":"Set-PartnerOfRecord / CompanyAdministrator role assignments / New-DelegatedAdminRelationship","platforms":["Identity Provider"],"analytic_id":"AN1347","source_url":"https://attack.mitre.org/detectionstrategies/DET0488#AN1347","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"}]},{"id":"AN1348","name":"Analytic 1348","guidance":"Behavioral chain: (1) cross-account or third-party principal assumes a role into the tenant/subscription/project; (2) privileged API calls are made in short succession; (3) access originates from unfamiliar networks or geos. Correlate assume-role/federation events with sensitive API usage.","url":"https://attack.mitre.org/detectionstrategies/DET0488#AN1348","platforms":["IaaS"],"tuning":[{"field":"ExternalAccountAllowList","description":"Cross-account principals permitted to assume roles; used for allow-listing."},{"field":"SensitiveAPIs","description":"Provider-specific list of risky APIs for scoring."},{"field":"GeoVelocityThreshold","descripti
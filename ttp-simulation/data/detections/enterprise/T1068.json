ption":"Targeted BYOVD drivers may vary based on campaign and tooling."},{"field":"TimeWindow","description":"Controls temporal linking of driver load → process spawn → privilege use."},{"field":"ParentProcessPath","description":"Parent-child relationships vary by exploitation vector (e.g., LOLBin vs. dropper)."}],"log_sources":[{"component_id":"DC0079","component":"Driver Load","name":"WinEventLog:Sysmon","channel":"EventCode=6","platforms":["Windows"],"analytic_id":"AN1419","source_url":"https://attack.mitre.org/detectionstrategies/DET0514#AN1419","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0079/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1419","source_url":"https://attack.mitre.org/detectionstrategies/DET0514#AN1419","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0088","component":"Logon Session Metadata","name":"WinEventLog:Security","channel":"EventCode=4672","platforms":["Windows"],"analytic_id":"AN1419","source_url":"https://attack.mitre.org/detectionstrategies/DET0514#AN1419","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0088/"}]},{"id":"AN1420","name":"Analytic 1420","guidance":"Detects escalation via vulnerable setuid binaries or kernel modules, often chained with unusual access to /proc/kallsyms or /dev/kmem.","url":"https://attack.mitre.org/detectionstrategies/DET0514#AN1420","platforms":["Linux"],"tuning":[{"field":"SetUIDBinaryList","description":"Legitimate SUID binaries vary across distributions; false positives may arise."},{"field":"TimeWindow","description":"Allows chaining kernel module load with privilege spike or privilege-sensitive process activity."},{"field":"EffectiveUIDThreshold","description":"Default is uid=0, but environments may vary with containerized root-like accounts."}],"log_s
c-t1204-1","technique_id":"T1204","title":"T1204 User Execution","kind":"basic","source_url":"https://1200km.com/anomaly-detection-atlas/attack-basic-detection-rule-catalog/#execution","source_path":"docs/attack-basic-detection-rule-catalog.md","source_line":61,"pinned_source_url":"https://github.com/anpa1200/anomaly-detection-atlas/blob/e1f75007376022b2f596e413bea8612e514a5aa3/docs/attack-basic-detection-rule-catalog.md#L61","source_file_sha256":"396a87e3d8da74d170684c0f377fe5dc11cd1a486d4f2f89f7fbe94deaaa2a1e","source_row_sha256":"2bdfe26decd6b0f28a7ad612eacc7768db5d6e73e8d9dada65432d7f93444fb9","validation":"published_concept_not_executable_or_live_validated","logic":"SEQUENCE(file_download_or_attachment_open, process_execution FROM downloaded_file) WITHIN 5m -> ALERT","log_sources":[{"title":"File-System Activity Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#13-file-system-activity-logs"},{"title":"Process Execution Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#6-process-execution-logs"},{"title":"Email Gateway Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#72-email-gateway-logs"}]}],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0478","name":"User Execution – multi-surface behavior chain (documents/links → helper/unpacker → LOLBIN/child → egress)","url":"https://attack.mitre.org/detectionstrategies/DET0478","stix_id":"x-mitre-detection-strategy--70c9f174-2e96-4086-b59c-d2358e434f8e","relationship_id":"relationship--7a3c280c-1116-4197-812a-e233eb1d5a17","description":"","analytics":[{"id":"AN1314","name":"Analytic 1314","guidance":"Cause→effect chain: (1) User-facing app (Office/PDF/archiver/browser) records an open/click or abnormal event, then (2) a downloaded file is created in a user-writable path and/or decompressed, (3) the parent user app spawns a living-off-the-land binary (e.g., powershell/cmd/mshta/rundll32/msiexec/wscript/expand/zip) or installer, and (4) immediate outbound HTTP(S)/DNS/SMB from the same lineage.","url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1314","platforms":["Windows"],"tuning":[{"field":"TimeWindow","description":"Correlation window (e.g., 15 minutes) from document open to child/egress."},{"field":"HighRiskParents","description":"Apps that should rarely spawn OS utilities (winword.exe, excel.exe, powerpnt.exe, acrord32.exe, chrome/msedge/firefox, 7zFM.exe, winrar.exe, explorer.exe)."},{"field":"HighRiskChildren","description":"LOLBIN list: powershell.exe, cmd.exe, wscript.exe, cscript.exe, mshta.exe, rundll32.exe, regsvr32.exe, msiexec.exe, curl.exe, bitsadmin.exe, pcalua.exe, expand.exe, tar.exe."},{"field":"UserPaths","description":"Writable paths to watch: %USERPROFILE%\\Downloads, %TEMP%, %APPDATA%\\*, OneDrive/Teams cache, Office startup folders."},{"field":"EgressAllowList","description":"Corporate update/CDN domains and proxy egress CIDRs to suppress benign updater traffic."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"WinEventLog:Application","channel":"EventCode=1000","platforms":["Windows"],"analytic_id":"AN1314","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1314","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN1314","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1314","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN1314","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1314","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN1314","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1314","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"}]},{"id":"AN1315","name":"Analytic 1315","guidance":"Cause→effect chain: (1) User app/browser/archiver logs an open/click or abnormal exit, (2) new executable/script/archive extracted into $HOME/Downloads, /tmp, or ~/.cache, (3) parent app spawns shell/interpreter (bash/sh/python/node/curl/wget) or desktop file, and (4) new outbound connection(s) from the child lineage.","url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","platforms":["Linux"],"tuning":[{"field":"TimeWindow","description":"5–20 minute correlation window."},{"field":"UserPaths","description":"$HOME/Downloads, /tmp, ~/.cache, ~/.config/autostart, ~/.local/share."},{"field":"HighRiskChildren","description":"bash, sh, zsh, python*, perl, node, curl, wget, xdg-open, kde-open, gio open, unzip/tar extraction leading to exec."},{"field":"PkgUpdaters","description":"Allow-list snap/flatpak/packagekit/apt workers to reduce false positives."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"linux:syslog","channel":"opened document|clicked link|segfault|abnormal termination|sandbox","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"open","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0039","component":"File Creation","name":"auditd:SYSCALL","channel":"creat","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"rename,chmod","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"NSM:Flow","channel":"new outbound connection from browser/office lineage","platforms":["Linux"],"analytic_id":"AN1315","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1315","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"}]},{"id":"AN1316","name":"Analytic 1316","guidance":"Cause→effect chain: (1) unified logs show application open/click or crash for Safari/Chrome/Office/Preview/archiver, (2) file write/extraction into ~/Downloads, /private/var/folders/* or ~/Library, (3) parent app spawns osascript/bash/zsh/curl/python or opens a quarantined app with Gatekeeper prompts, (4) network egress from child.","url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1316","platforms":["macOS"],"tuning":[{"field":"TimeWindow","description":"10–30 minute correlation window."},{"field":"HighRiskChildren","description":"osascript, bash, zsh, curl, python, open -a Terminal, installer, tccutil misuse."},{"field":"QuarantineSignals","description":"Flag new apps lacking com.apple.quarantine or with quarantine='0081' (downloaded then auto-opened)."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"macos:unifiedlog","channel":"opened document|clicked link|EXC_BAD_ACCESS|abort|LSQuarantine","platforms":["macOS"],"analytic_id":"AN1316","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1316","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0039","component":"File Creation","name":"fs:fileevents","channel":"create/write/rename in user-writable paths","platforms":["macOS"],"analytic_id":"AN1316","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1316","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:osquery","channel":"exec","platforms":["macOS"],"analytic_id":"AN1316","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1316","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"NSM:Flow","channel":"new outbound connection from exploited lineage","platforms":["macOS"],"analytic_id":"AN1316","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1316","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"}]},{"id":"AN1317","name":"Analytic 1317","guidance":"Cause→effect chain in CI/dev desktops: (1) user triggers container run/pull after opening a doc/link/script, (2) newly created image/container uses unexpected external registry or entrypoint, (3) container starts and immediately egresses to suspicious destinations.","url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1317","platforms":["Containers"],"tuning":[{"field":"TrustedRegistries","description":"Approved registries/namespaces."},{"field":"AllowedEntrypoints","description":"Expected CMD/ENTRYPOINT for known images."},{"field":"TimeWindow","description":"Correlate user action → docker/podman run within 10 minutes."}],"log_sources":[{"component_id":"DC0072","component":"Container Creation","name":"docker:events","channel":"created,started: new container from untrusted registry or unexpected entrypoint","platforms":["Containers"],"analytic_id":"AN1317","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1317","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0072/"},{"component_id":"DC0077","component":"Container Start","name":"docker:events","channel":"start","platforms":["Containers"],"analytic_id":"AN1317","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1317","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0077/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"NSM:Flow","channel":"container egress to unknown IPs/domains","platforms":["Containers"],"analytic_id":"AN1317","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1317","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]},{"id":"AN1318","name":"Analytic 1318","guidance":"Cause→effect chain in cloud consoles: (1) user clicks link then invokes instance/image creation via API, (2) instance/image originates from external AMI or unknown image, (3) instance immediately egresses or retrieves payloads.","url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1318","platforms":["IaaS"],"tuning":[{"field":"ApprovedImages","description":"AMI/image allow-list with owners."},{"field":"UserContext","description":"High-risk identities (federated, external IdP)."},{"field":"TimeWindow","description":"5–30 minutes from console/API action to network egress."}],"log_sources":[{"component_id":"DC0076","component":"Instance Creation","name":"AWS:CloudTrail","channel":"RunInstances,CreateImage","platforms":["IaaS"],"analytic_id":"AN1318","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1318","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0076/"},{"component_id":"DC0080","component":"Instance Start","name":"AWS:CloudTrail","channel":"StartInstances","platforms":["IaaS"],"analytic_id":"AN1318","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1318","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0080/"},{"component_id":"DC0085","component":"Network Traffic Content","name":"gcp:vpcflow","channel":"first 5m egress to unknown ASNs","platforms":["IaaS"],"analytic_id":"AN1318","source_url":"https://attack.mitre.org/detectionstrategies/DET0478#AN1318","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0085/"}]}]}],"telemetry_references":[{"id":"DC0038","name":"Application Log Content","tag":"Application Log Content","page":"telemetry/DC0038/","kind":"attack_component"},{"id":"DC0072","name":"Container Creation","tag":"Container Creation","page":"telemetry/DC0072/","kind":"attack_component"},{"id":"DC0077","name":"Container Start","tag":"Container Start","page":"telemetry/DC0077/","kind":"attack_component"},{"id":"DC0055","name":"File Access","tag":"File Access","page":"telemetry/DC0055/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0061","name":"File Modification","tag":"File Modification","page":"telemetry/DC0061/","kind":"attack_component"},{"id":"DC0076","name":"Instance Creation","tag":"Instance Creation","page":"telemetry/DC0076/","kind":"attack_component"},{"id":"DC0080","name":"Instance Start","tag":"Instance Start","page":"telemetry/DC0080/","kind":"attack_component"},{"id":"DC0082","name":"Network Connection Cre
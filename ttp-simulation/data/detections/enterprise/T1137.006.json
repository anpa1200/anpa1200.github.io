ic locations"},{"field":"AddInTrigger","description":"Some add-ins only load on specific actions (new document, open file, etc.)"}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"WinEventLog:Application","channel":"Office Add-in load errors, abnormal loading context, or unsigned add-in warnings","platforms":["Office Suite"],"analytic_id":"AN0138","source_url":"https://attack.mitre.org/detectionstrategies/DET0050#AN0138","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0064","component":"Command Execution","name":"WinEventLog:Microsoft-Office/OutlookAddinMonitor","channel":"Outlook loading add-in via unexpected load path or non-default profile context","platforms":["Office Suite"],"analytic_id":"AN0138","source_url":"https://attack.mitre.org/detectionstrategies/DET0050#AN0138","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"}]}]}],"telemetry_references":[{"id":"DC0038","name":"Application Log Content","tag":"Application Log Content","page":"telemetry/DC0038/","kind":"attack_component"},{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0061","name":"File Modification","tag":"File Modification","page":"telemetry/DC0061/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"},{"id":"DC0063","name":"Windows Registry Key Modification","tag":"Windows Registry Key Modification","page":"telemetry/DC0063/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[],"related_parent":{"key":"enterprise/T1137","id":"T1137","name":"Office Application Startup","page":"detections/enterprise/T1137/","note":"Related
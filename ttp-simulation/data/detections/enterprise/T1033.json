ategies/DET0093#AN0257","platforms":["Network Devices"],"tuning":[{"field":"CLICommandBaseline","description":"Expected command set per device role/user role combination"},{"field":"DeviceRoleSensitivity","description":"Correlate access with core vs. edge vs. management plane sensitivity"},{"field":"CommandFrequencyThreshold","description":"Detect burst usage of `show` or `debug` commands by non-admin users"}],"log_sources":[{"component_id":"DC0021","component":"OS API Execution","name":"networkdevice:syslog","channel":"aaa privilege_exec","platforms":["Network Devices"],"analytic_id":"AN0257","source_url":"https://attack.mitre.org/detectionstrategies/DET0093#AN0257","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0021/"},{"component_id":"DC0064","component":"Command Execution","name":"networkdevice:syslog","channel":"eventlog","platforms":["Network Devices"],"analytic_id":"AN0257","source_url":"https://attack.mitre.org/detectionstrategies/DET0093#AN0257","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"}]}]}],"telemetry_references":[{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0021","name":"OS API Execution","tag":"OS API Execution","page":"telemetry/DC0021/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[{"id":"S1087","name":"AsyncRAT","page":"tools/S1087/","bases":["attack_uses"]},{"id":"S0521","name":"BloodHound","page":"tools/S0521/","bases":["attack_uses"]},{"id":"S0363","name":"Empire","page":"tools/S0363/","bases":["attack_uses"]},{"id":"S0250","name":"Koadic","page":"tools/S0250/","bases":["attack_uses"]},{"id":"S0590","name":"NBTscan","page":"tools/S0590/","bases":["attack_uses"]},{"id":"S0192","name":"Pupy","page":"tools
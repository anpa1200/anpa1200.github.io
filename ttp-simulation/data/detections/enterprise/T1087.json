ly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#78-fan-out-anomaly"},{"title":"Peer-Group Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#8-peer-group-anomaly"},{"title":"Volume Anomaly","url":"https://1200km.com/anomaly-detection-atlas/statistical-anomaly-taxonomy/#15-volume-anomaly"}],"strategies":[{"id":"DET0587","name":"Enumeration of User or Account Information Across Platforms","url":"https://attack.mitre.org/detectionstrategies/DET0587","stix_id":"x-mitre-detection-strategy--fdda430c-e4f6-43ce-95d6-0f97253ff6a2","relationship_id":"relationship--6977ce04-33d6-4080-8e9c-ac61a4a48dfa","description":"","analytics":[{"id":"AN1612","name":"Analytic 1612","guidance":"Detection of processes performing local or domain account enumeration by invoking account directory queries or security APIs followed by structured output of account lists. The defender observes command execution or API invocation patterns that retrieve account information and produce enumeration artifacts shortly afterward.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1612","platforms":["Windows"],"tuning":[{"field":"CommandLinePattern","description":"Match variations in enumeration commands like 'net user', 'Get-ADUser', 'dsquery'."},{"field":"TimeWindow","description":"Short burst of account enumeration commands may indicate automation."},{"field":"UserContext","description":"Restrict to non-admin accounts or unexpected users executing enumeration commands."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1612","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1612","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN1612","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1612","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0099","component":"Group Enumeration","name":"WinEventLog:Security","channel":"EventCode=4798, 4799","platforms":["Windows"],"analytic_id":"AN1612","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1612","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0099/"}]},{"id":"AN1613","name":"Analytic 1613","guidance":"Enumeration of users and groups through suspicious shell commands or unauthorized access to /etc/passwd or /etc/shadow.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1613","platforms":["Linux"],"tuning":[{"field":"AccessedFile","description":"Tune based on file paths such as '/etc/passwd', '/etc/group', '/etc/shadow'."},{"field":"ParentProcessName","description":"Filter known admin processes to reduce false positives."}],"log_sources":[{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"PATH","platforms":["Linux"],"analytic_id":"AN1613","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1613","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0032","component":"Process Creation","name":"linux:Sysmon","channel":"EventCode=1","platforms":["Linux"],"analytic_id":"AN1613","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1613","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN1614","name":"Analytic 1614","guidance":"Detection of account enumeration through directory service queries or system utilities accessing account metadata stores, followed by structured enumeration output.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1614","platforms":["macOS"],"tuning":[{"field":"CommandLine","description":"Tune for dscl -list, dscacheutil -q user, id -un, etc."},{"field":"ExecutionContext","description":"Alert if enumeration is performed in non-console session or by unusual users."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"macos:unifiedlog","channel":"process event","platforms":["macOS"],"analytic_id":"AN1614","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1614","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0013","component":"User Account Metadata","name":"macos:unifiedlog","channel":"DirectoryService queries retrieving account information","platforms":["macOS"],"analytic_id":"AN1614","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1614","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0013/"}]},{"id":"AN1615","name":"Analytic 1615","guidance":"Detection of enumeration of identity entities through cloud provider APIs where principals retrieve account metadata such as IAM users or roles in rapid succession.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1615","platforms":["IaaS"],"tuning":[{"field":"API_Method","description":"Tune based on which IAM APIs are used and their frequency."},{"field":"CallerType","description":"Differentiate user-initiated from automated/scripted enumeration."}],"log_sources":[{"component_id":"DC0083","component":"Cloud Service Enumeration","name":"AWS:CloudTrail","channel":"DescribeUsers / ListUsers / GetUser","platforms":["IaaS"],"analytic_id":"AN1615","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1615","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0083/"}]},{"id":"AN1616","name":"Analytic 1616","guidance":"Detection of identity directory enumeration through API calls or administrative queries retrieving multiple account objects within 
ess to user directory features or hidden APIs.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1618","platforms":["SaaS"],"tuning":[{"field":"EndpointURL","description":"Tune based on enumeration from directory endpoints such as /users, /groups."},{"field":"UserAgent","description":"Detect scripted enumeration via curl/wget or unknown tools."}],"log_sources":[{"component_id":"DC0013","component":"User Account Metadata","name":"gcp:audit","channel":"Directory API Access","platforms":["SaaS"],"analytic_id":"AN1618","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1618","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0013/"}]},{"id":"AN1619","name":"Analytic 1619","guidance":"Account discovery via VBA macros, COM objects, or embedded scripting.","url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1619","platforms":["Office Suite"],"tuning":[{"field":"MacroName","description":"Alert on auto-running macros accessing directory or user info."},{"field":"ExecutionScope","description":"Focus on macros invoking LDAP, ADODB, or WMI queries."}],"log_sources":[{"component_id":"DC0029","component":"Script Execution","name":"m365:unified","channel":"Scripted Activity","platforms":["Office Suite"],"analytic_id":"AN1619","source_url":"https://attack.mitre.org/detectionstrategies/DET0587#AN1619","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0029/"}]}]}],"telemetry_references":[{"id":"DC0083","name":"Cloud Service Enumeration","tag":"Cloud Service Enumeration","page":"telemetry/DC0083/","kind":"attack_component"},{"id":"DC0064","name":"Command Execution","tag":"Command Execution","page":"telemetry/DC0064/","kind":"attack_component"},{"id":"DC0055","name":"File Access","tag":"File Access","page":"telemetry/DC0055/","kind":"attack_component"},{"id":"DC0099","name":"Group Enumeration","tag":"Group Enumeration","page":"telemetry/DC0099/","kind":"attack_component"},{
","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#12-memory-protection-and-exploit-mitigation-logs"},{"title":"Operating-System Crash and Diagnostic Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#38-operating-system-crash-and-diagnostic-logs"},{"title":"Process Execution Logs","url":"https://1200km.com/anomaly-detection-atlas/security-log-source-taxonomy/#6-process-execution-logs"}]}],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0287","name":"Exploitation for Client Execution – cross-platform behavior chain (browser/Office/3rd-party apps)","url":"https://attack.mitre.org/detectionstrategies/DET0287","stix_id":"x-mitre-detection-strategy--1894c2d7-ce4f-4cfd-8644-decb1e14f0c5","relationship_id":"relationship--f094c21c-9872-4e82-88c1-c759979c4f10","description":"","analytics":[{"id":"AN0797","name":"Analytic 0797","guidance":"Cause→effect chain: (1) A client app (browser, Office, PDF/Flash/reader) experiences a crash/abnormal exit or loads from an unusual location, then (2) drops or modifies a file in user-writable paths, and/or (3) spawns an unexpected child (e.g., powershell/cmd/mshta/rundll32/wscript/installer), and (4) establishes outbound C2-like connections shortly after. Correlate application logs, file writes, process lineage, and network egress within a short window.","url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0797","platforms":["Windows"],"tuning":[{"field":"TimeWindow","description":"Correlation window (e.g., 15m) between crash/write/child/network."},{"field":"HighRiskChildren","description":"List of child processes that should rarely spawn from Office/browsers (powershell.exe, cmd.exe, wscript.exe, mshta.exe, rundll32.exe, regsvr32.exe, msiexec.exe, curl.exe)."},{"field":"UserPaths","description":"Writable paths to watch (Downloads, %TEMP%, %APPDATA%, OneDrive, Office startup folders)."},{"field":"AllowedPlugins","description":"Known add-ins/extensions and updater binaries to reduce noise."},{"field":"EgressAllowlist","description":"Known update/CDN domains and proxy egress CIDRs for suppression."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"WinEventLog:Application","channel":"EventCode=1000","platforms":["Windows"],"analytic_id":"AN0797","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0797","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0797","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0797","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN0797","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0797","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0082","component":"Network Connection Creation","name":"WinEventLog:Sysmon","channel":"EventCode=3, 22","platforms":["Windows"],"analytic_id":"AN0797","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0797","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0082/"}]},{"id":"AN0798","name":"Analytic 0798","guidance":"Cause→effect chain: (1) Browser/Office/reader process logs crash/segfault or abnormal sandbox message, (2) new executable/script/write occurs in $HOME (Downloads, ~/.cache, /tmp), (3) unexpected child like curl/wget/bash/python opens network connections soon after.","url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","platforms":["Linux"],"tuning":[{"field":"TimeWindow","description":"5–20m correlation window."},{"field":"UserPaths","description":"HOME write targets: ~/Downloads, ~/.config/autostart, ~/.local/share, /tmp."},{"field":"HighRiskChildren","description":"bash, sh, python, perl, node, curl, wget, socat, openssl, xxd."},{"field":"PackageUpdaters","description":"Allow-list common updaters (snap, flatpak, packagekit) to reduce FP."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"linux:syslog","channel":"browser/office crash, segfault, abnormal termination","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"open","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0039","component":"File Creation","name":"auditd:SYSCALL","channel":"creat","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"rename,chmod","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"NetFlow:Flow","channel":"new outbound connections from exploited process tree","platforms":["Linux"],"analytic_id":"AN0798","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0798","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]},{"id":"AN0799","name":"Analytic 0799","guidance":"Cause→effect chain: (1) App crash/abnormal termination in unified logs for Safari/Chrome/Office/Preview, (2) new files/scripts in ~/Library, ~/Downloads, /private/var/folders/*, (3) unexpected child (osascript, zsh, bash, curl) spawned by those apps, (4) new outbound connections.","url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0799","platforms":["macOS"],"tuning":[{"field":"TimeWindow","description":"10–30m correlation window."},{"field":"HighRiskChildren","description":"osascript, bash, zsh, curl, python, pbpaste/pbcopy, open -a Terminal."},{"field":"UserPaths","description":"~/Library/LaunchAgents, ~/Library/Containers/*/Data, /private/var/folders/*."},{"field":"QuarantineBypass","description":"Flag files with missing com.apple.quarantine extended attribute when sourced from internet."}],"log_sources":[{"component_id":"DC0038","component":"Application Log Content","name":"macos:unifiedlog","channel":"process crash, abort, code signing violations","platforms":["macOS"],"analytic_id":"AN0799","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0799","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0038/"},{"component_id":"DC0061","component":"File Modification","name":"fs:fsevents","channel":"create/write/rename under user-writable paths","platforms":["macOS"],"analytic_id":"AN0799","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0799","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"},{"component_id":"DC0032","component":"Process Creation","name":"macos:osquery","channel":"exec","platforms":["macOS"],"analytic_id":"AN0799","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0799","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0078","component":"Network Traffic Flow","name":"NSM:Connections","channel":"new connections from exploited lineage","platforms":["macOS"],"analytic_id":"AN0799","source_url":"https://attack.mitre.org/detectionstrategies/DET0287#AN0799","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0078/"}]}]}],"telemetry_references":[{"id":"DC0038","name":"Application Log Content","tag":"Application Log Content","page":"telemetry/DC0038/","kind":"attack_component"},{"id":"DC0055","name":"File Access","tag":"File Access","page":"telemetry/DC0055/","kind":"attack_component"},{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0061","name":"File Modification","tag":"File Modification","page":"telemetry/DC0061/","kind":"attack_component"},{"id":"DC0082","name":"Network Connection Creation","tag":"Network Connection Creation","page":"telemetry/DC0082/","kind":"attack_component"},{"id":"DC0078","name":"Network Traffic Flow","tag":"Network Traffic Flow","page":"telemetry/DC0078/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[{"id":"S0154","name":"Cobalt Strike","page":"tools/S0154/","bases":["attack_uses"]}],"related_parent":null,"article_url":"https://1200km.com/articles/read/2026/2026-04-20-malicious-activity-as-a-statistical-signal-a-detection-engineering-analysis-of-anomaly-bas-90df8b6dea12/","validation":{"source_join":"exact_ids","sigma_yaml":"parsed","backend_compilation":"not_run","live_telemetry":"not_run","detection_execution":"not_run"}}

{"key":"enterprise/T1129","id":"T1129","name":"Shared Modules","domain":"enterprise","platforms":["Linux","macOS","Windows"],"environments":["cloud-hosted-endpoint","onprem"],"source_url":"https://attack.mitre.org/techniques/T1129","technique_page":"techniques/enterprise/T1129/","page":"detections/enterprise/T1129/","status":"rule_source_available","counts":{"sigma":1,"atlas_basic":0,"atlas_anomaly":0,"strategies":1,"analytics":3,"live_validated":0},"sigma_rules":[{"id":"e5f5c693-52d7-4de5-88ae-afbfbce85595","title":"Unsigned .node File Loaded","status":"experimental","level":"medium","logsource":{"category":"image_load","product":"windows"},"data_path":"data/detection-rules/e5f5c693-52d7-4de5-88ae-afbfbce85595.json","source_url":"https://github.com/anpa1200/sigma/blob/b249e9683190cffdcaf188ccbfb90bf4759844e1/rules/windows/image_load/image_load_dll_unsigned_node_load.yml","author":"Jonathan Beierle (@hullabrian)","kind":"sigma"}],"atlas_basic":[],"atlas_anomaly":[],"anomaly_types":[],"strategies":[{"id":"DET0018","name":"Behavior-chain, platform-aware detection strategy for T1129 Shared Modules","url":"https://attack.mitre.org/detectionstrategies/DET0018","stix_id":"x-mitre-detection-strategy--928a6ce6-fca0-4d66-aba3-1121431b953e","relationship_id":"relationship--20d31ad8-56fd-4268-b650-6106617cc9bc","description":"","analytics":[{"id":"AN0052","name":"Analytic 0052","guidance":"A process (often LOLBin or user-launched program) loads a DLL from a user-writable/UNC/Temp path or unsigned/invalid signer. Within a short window the DLL is (a) newly written to disk, (b) spawned as follow-on execution (rundll32/regsvr32), or (c) establishes outbound C2.","url":"https://attack.mitre.org/detectionstrategies/DET0018#AN0052","platforms":["Windows"],"tuning":[{"field":"TimeWindow","description":"Correlation window between file write → module load → network (e.g., 0–20 minutes)."},{"field":"SuspiciousPathRegex","description":"Regex for user-writable/UNC/temp paths to flag (e.g.,
rame"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN0095","source_url":"https://attack.mitre.org/detectionstrategies/DET0034#AN0095","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0035","component":"Process Access","name":"WinEventLog:Sysmon","channel":"EventCode=10","platforms":["Windows"],"analytic_id":"AN0095","source_url":"https://attack.mitre.org/detectionstrategies/DET0034#AN0095","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0035/"}]},{"id":"AN0096","name":"Analytic 0096","guidance":"Detects execution of common process enumeration utilities (e.g., ps, top, htop) or access to /proc with suspicious ancestry. Correlates command usage with interactive shell context and user role.","url":"https://attack.mitre.org/detectionstrategies/DET0034#AN0096","platforms":["Linux"],"tuning":[{"field":"AccessedPath","description":"Filter based on suspicious /proc directory enumeration or high-volume ls/readlink usage"},{"field":"UserContext","description":"Helps tune for root vs. low-priv users during interactive vs. scripted activity"}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"auditd:SYSCALL","channel":"execve","platforms":["Linux"],"analytic_id":"AN0096","source_url":"https://attack.mitre.org/detectionstrategies/DET0034#AN0096","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0055","component":"File Access","name":"auditd:SYSCALL","channel":"openat","platforms":["Linux"],"analytic_id":"AN0096","source_url":"https://attack.mitre.org/detectionstrategies/DET0034#AN0096","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0055/"},{"component_id":"DC0035","component":"Process Access","name":"linux:osquery","channel"
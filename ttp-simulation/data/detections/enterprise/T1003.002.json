":"","analytics":[{"id":"AN0235","name":"Analytic 0235","guidance":"An adversary running with SYSTEM-level privileges executes commands or accesses registry keys to dump the SAM hive or directly reads sensitive local files from the config directory. This behavior often involves sequential access to HKLM\\SAM, HKLM\\SYSTEM, and creation of .save or .dmp files, enabling offline hash extraction.","url":"https://attack.mitre.org/detectionstrategies/DET0085#AN0235","platforms":["Windows"],"tuning":[{"field":"CommandLinePattern","description":"Detectable variations include `reg save`, `reg.exe save`, or PowerShell equivalents for dumping SAM/SYSTEM hives."},{"field":"TargetFilePath","description":"Defenders can tune based on dump file path patterns (e.g., `%TEMP%\\sam.save`, `C:\\Users\\Public\\*.dmp`)."},{"field":"RegistryPath","description":"Tune for HKLM\\SAM, HKLM\\SYSTEM or access via direct \\Device\\Harddisk paths."},{"field":"TimeWindow","description":"Temporal gap between SAM and SYSTEM hive dumping can be tuned (e.g., 3 minutes)."},{"field":"ParentProcessName","description":"Useful for suppressing known-good access (e.g., backup tools)."}],"log_sources":[{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Security","channel":"EventCode=4688","platforms":["Windows"],"analytic_id":"AN0235","source_url":"https://attack.mitre.org/detectionstrategies/DET0085#AN0235","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"},{"component_id":"DC0063","component":"Windows Registry Key Modification","name":"WinEventLog:Sysmon","channel":"EventCode=13, 14","platforms":["Windows"],"analytic_id":"AN0235","source_url":"https://attack.mitre.org/detectionstrategies/DET0085#AN0235","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0063/"},{"component_id":"DC0039","component":"File Creation","name":"WinEventLog:Sysmon","channel":"EventCode=11","platforms":["Windows"],"analytic_id":"AN0235","source_url":"https://attack.mitre.org/detectionstrategies/DET0085#AN0235","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0039/"},{"component_id":"DC0061","component":"File Modification","name":"WinEventLog:Sysmon","channel":"EventCode=2","platforms":["Windows"],"analytic_id":"AN0235","source_url":"https://attack.mitre.org/detectionstrategies/DET0085#AN0235","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]}]}],"telemetry_references":[{"id":"DC0039","name":"File Creation","tag":"File Creation","page":"telemetry/DC0039/","kind":"attack_component"},{"id":"DC0061","name":"File Modification","tag":"File Modification","page":"telemetry/DC0061/","kind":"attack_component"},{"id":"DC0032","name":"Process Creation","tag":"Process Creation","page":"telemetry/DC0032/","kind":"attack_component"},{"id":"DC0063","name":"Windows Registry Key Modification","tag":"Windows Registry Key Modification","page":"telemetry/DC0063/","kind":"attack_component"}],"visibility":"source_mapped","visibility_note":null,"tool_references":[{"id":"S0154","name":"Cobalt Strike","page":"tools/S0154/","bases":["attack_uses"]},{"id":"S0488","name":"CrackMapExec","page":"tools/S0488/","bases":["attack_uses"]},{"id":"S0120","name":"Fgdump","page":"tools/S0120/","bases":["attack_uses"]},{"id":"S0008","name":"gsecdump","page":"tools/S0008/","bases":["attack_uses"]},{"id":"S0357","name":"Impacket","page":"tools/S0357/","bases":["attack_uses"]},{"id":"S0250","name":"Koadic","page":"tools/S0250/","bases":["attack_uses"]},{"id":"S0002","name":"Mimikatz","page":"tools/S0002/","bases":["attack_uses"]},{"id":"S0006","name":"pwdump","page":"tools/S0006/","bases":["attack_uses"]}],"related_parent":{"key":"enterprise/T1003","id":"T1003","name":"OS Credential Dumping","page":"detections/enterprise/T1003/","note":"Related parent research only. Not inherited rule or anomaly coverage for this sub-technique."},"article_url":"https:/
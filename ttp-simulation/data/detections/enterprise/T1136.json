DET0583","stix_id":"x-mitre-detection-strategy--552bacaa-9df5-4c95-83de-a7d1948003b5","relationship_id":"relationship--bd9b60eb-dc7a-4806-b882-040b17e4f5b4","description":"","analytics":[{"id":"AN1604","name":"Analytic 1604","guidance":"Adversary uses built-in OS tools or API calls to create local or domain accounts for persistence or lateral movement. Tools such as 'net user', PowerShell, or MMC snap-ins may be used. Detection focuses on Event ID 4720 paired with process lineage and user context.","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","platforms":["Windows"],"tuning":[{"field":"TimeWindow","description":"Correlation between Event ID 4720 and creating process may vary by environment and automation delays"},{"field":"ParentProcessName","description":"Tools like net.exe or powershell.exe can be normal or malicious depending on user context"},{"field":"UserContext","description":"System vs. administrator vs. low-privilege user context changes alert criticality"}],"log_sources":[{"component_id":"DC0014","component":"User Account Creation","name":"WinEventLog:Security","channel":"EventCode=4720","platforms":["Windows"],"analytic_id":"AN1604","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0032","component":"Process Creation","name":"WinEventLog:Sysmon","channel":"EventCode=1","platforms":["Windows"],"analytic_id":"AN1604","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1604","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0032/"}]},{"id":"AN1605","name":"Analytic 1605","guidance":"Adversary invokes 'useradd', 'adduser', or equivalent system commands or scripts to create local users. Detection focuses on command execution and audit trail of passwd/shadow file modifications.","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","platforms":["Linux"],"tuning":[{"field":"BinaryPath","description":"Custom scripts or renamed binaries may evade simple path-based detection"},{"field":"ExecutionTime","description":"Account creation outside maintenance windows may indicate compromise"}],"log_sources":[{"component_id":"DC0014","component":"User Account Creation","name":"auditd:SYSCALL","channel":"useradd or adduser executed","platforms":["Linux"],"analytic_id":"AN1605","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0061","component":"File Modification","name":"auditd:SYSCALL","channel":"chmod/chown to /etc/passwd or /etc/shadow","platforms":["Linux"],"analytic_id":"AN1605","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1605","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]},{"id":"AN1606","name":"Analytic 1606","guidance":"Adversary creates new users using 'dscl' commands, GUI tools, or by modifying user plist files. Detection includes monitoring dscl invocation and user-related plist changes.","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1606","platforms":["macOS"],"tuning":[{"field":"UsernamePattern","description":"Attackers may use service-like names to hide malicious accounts"},{"field":"ExecutionSource","description":"Accounts created via Terminal vs GUI vs remote session can affect confidence"}],"log_sources":[{"component_id":"DC0064","component":"Command Execution","name":"macos:unifiedlog","channel":"dscl . -create","platforms":["macOS"],"analytic_id":"AN1606","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1606","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0064/"},{"component_id":"DC0061","component":"File Modification","name":"macos:unifiedlog","channel":"modification to /var/db/dslocal/nodes/Default/users/","platforms":["macOS"],"analytic_id":"AN1606","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1606","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0061/"}]},{"id":"AN1607","name":"Analytic 1607","guidance":"Adversary creates users via IAM/IdP API or portal (e.g., Azure AD, Okta). Detection involves monitoring API calls, admin action logs, and correlation with role assignments.","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1607","platforms":["Identity Provider"],"tuning":[{"field":"AdminThreshold","description":"Trigger alert only when account is assigned privileged roles"},{"field":"AutomationExemptions","description":"Exclude accounts from known automation processes or provisioning pipelines"}],"log_sources":[{"component_id":"DC0014","component":"User Account Creation","name":"azure:audit","channel":"Add user","platforms":["Identity Provider"],"analytic_id":"AN1607","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1607","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"}]},{"id":"AN1608","name":"Analytic 1608","guidance":"Account creation via cloud service APIs or CLI, often associated with key generation. Monitored via CloudTrail or equivalent audit logs.","url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1608","platforms":["IaaS"],"tuning":[{"field":"Region","description":"Alert on account creation outside expected geographies"},{"field":"ServiceScope","description":"Filter on creation of users scoped to sensitive services"}],"log_sources":[{"component_id":"DC0014","component":"User Account Creation","name":"AWS:CloudTrail","channel":"CreateUser","platforms":["IaaS"],"analytic_id":"AN1608","source_url":"https://attack.mitre.org/detectionstrategies/DET0583#AN1608","validation":"upstream_definition_not_locally_validated","component_page":"telemetry/DC0014/"},{"component_id":"DC0010","component":"User Account Modi
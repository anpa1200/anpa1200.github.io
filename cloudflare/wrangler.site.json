{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1200km-site",
  "main": "./site-worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "1200km.com/*", "zone_id": "3b7d60bc8ed435424d085603a583bd2f" }],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "rules": [
    { "type": "Text", "globs": ["**/_headers"], "fallthrough": false }
  ]
}
